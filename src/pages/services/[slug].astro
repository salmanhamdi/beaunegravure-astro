---
import { Picture } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '@layouts/Base.astro';
import FilAriane from '@components/FilAriane.astro';
import Faq from '@components/Faq.astro';
import GrilleRealisations from '@components/GrilleRealisations.astro';
import SectionDevis from '@components/SectionDevis.astro';
import { CATEGORIES, imagesRealisations, parCategorie } from '@data/realisations';
import { urlAbsolue } from '@utils/env';
import {
  faqSchema,
  filAriane,
  graphe,
  organisation,
  pageWeb,
  serviceSchema,
} from '@utils/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const chemin = `/services/${service.id}/`;
const url = urlAbsolue(chemin);

const visuel = imagesRealisations[data.visuel]!;

/**
 * Proportion de la bande d'ouverture sur téléphone et tablette.
 *
 * Un ratio unique imposé aux dix pages recadrerait sévèrement les sources
 * verticales (le coffret d'impression UV est en 3/4, le panneau d'échantillons
 * en 2,23/1). On part donc de la proportion NATIVE de chaque photographie et on
 * la borne : sept des dix visuels tombent dans la fourchette et sont montrés
 * sans le moindre recadrage ; les trois autres sont ramenés à une bande qui
 * tient dans le premier écran sans couper leur sujet.
 */
const ratioTete = Math.min(Math.max(visuel.width / visuel.height, 0.9), 2.4);

const galerie = parCategorie(data.galerie).slice(0, 6);
const categorie = CATEGORIES[data.galerie];

/**
 * Les quatre savoir-faire qui SUIVENT celui-ci dans l'ordre, en repartant au
 * début une fois la liste épuisée.
 *
 * Un simple `.slice(0, 4)` ne citait jamais que les quatre premiers de la
 * liste : les six suivants — dont la signalétique, dernière — ne recevaient
 * aucun lien de leurs voisins. La fenêtre glissante donne à chaque page
 * exactement quatre liens entrants, sans ajouter un seul lien au site.
 */
const tousLesServices = (await getCollection('services')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const position = tousLesServices.findIndex((s) => s.id === service.id);
const autres = Array.from(
  { length: 4 },
  (_, i) => tousLesServices[(position + 1 + i) % tousLesServices.length]!,
);

const miettes = [
  { nom: 'Accueil', href: '/' },
  { nom: 'Savoir-faire', href: '/services/' },
  { nom: data.titre, href: chemin },
];

const schema = graphe([
  organisation('/og/beaune-gravure-partage.jpg'),
  pageWeb({ url, titre: data.seoTitle, description: data.description }),
  serviceSchema({ nom: data.h1, description: data.description, url }),
  filAriane(miettes),
  faqSchema(data.faq.map((f) => ({ question: f.question, reponse: f.reponse }))),
]);
---

<Base
  titre={data.seoTitle}
  description={data.description}
  chemin={chemin}
  schema={schema}
>
  <article>
    <header class="tete">
      <div class="enveloppe--large tete__grille" style={`--ratio-tete: ${ratioTete.toFixed(3)}`}>
        <div class="tete__copie">
          <FilAriane miettes={miettes} />
          <p class="surtitre">{data.surtitre}</p>
          <h1>{data.h1}</h1>
          <p class="chapo">{data.chapo}</p>
          <div class="boutons">
            <a class="bouton" href={`/contact/?projet=${encodeURIComponent(data.titre)}`}>
              Demander un devis
            </a>
            <a class="bouton bouton--fantome" href="#realisations">Voir les réalisations</a>
          </div>
          <ul class="tete__points">
            {data.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        <div class="tete__media">
          <Picture
            src={visuel}
            alt={`${data.titre} — réalisation de l’atelier Beaune Gravure`}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 64rem) 44vw, 100vw"
            loading="eager"
            fetchpriority="high"
            quality={74}
            formats={['avif']}
            fallbackFormat="webp"
          />
        </div>
      </div>
    </header>

    <section class="section">
      <div class="enveloppe prose contenu">
        <Content />
      </div>
    </section>

    <section class="section section--creuse" id="realisations">
      <div class="enveloppe--large">
        <div class="tete-section tete-section--duo">
          <div>
            <p class="surtitre">Réalisations</p>
            <h2>{categorie.titre}</h2>
          </div>
          <p class="chapo">{categorie.description}</p>
        </div>
        <GrilleRealisations realisations={galerie} colonnes={3} />
        <p class="suite">
          <a class="bouton bouton--fantome" href={`/realisations/${categorie.slug}/`}>
            Toute la catégorie {categorie.nom.toLowerCase()}
          </a>
        </p>
      </div>
    </section>

    <Faq entrees={data.faq.map((f) => ({ question: f.question, reponse: f.reponse }))} />

    {/*
      Dernière étape avant la demande de devis : ce qui détermine le prix et le
      délai. Aucun montant, aucune durée — l'atelier chiffre au projet. Le bloc
      est placé ici, après la démonstration et les questions fréquentes, parce
      qu'un appel à l'action ne convertit que si la question précédente a reçu
      sa réponse.
    */}
    <section class="section section--serree reperes">
      <div class="enveloppe">
        <p class="surtitre">Avant de demander un devis</p>
        <h2 class="reperes__titre">Ce qui détermine le prix et le délai.</h2>

        <div class="reperes__grille">
          <ul class="reperes__liste">
            {data.reperes.facteurs.map((facteur) => <li>{facteur}</li>)}
          </ul>

          <div class="reperes__texte">
            <p>{data.reperes.note}</p>
            <p class="reperes__chiffrage">
              Chaque projet est chiffré sur mesure : décrivez le vôtre, nous revenons
              vers vous avec un prix et un délai fermes.
            </p>
            {
              data.reperes.lien && (
                <a class="lien-fleche" href={data.reperes.lien.href}>
                  {data.reperes.lien.libelle}
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section section--serree">
      <div class="enveloppe">
        <p class="surtitre">Autres savoir-faire</p>
        <ul class="autres">
          {
            autres.map((autre) => (
              <li>
                <a href={`/services/${autre.id}/`}>
                  <strong>{autre.data.titre}</strong>
                  <span>{autre.data.usages}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>

  <SectionDevis projet={data.titre} />
</Base>

<style>
  .tete {
    padding-block: var(--e-l) var(--e-2xl);
  }

  /*
    Sous 64rem, la photographie ouvre la page.

    Elle ne descend pas simplement d'un cran dans le DOM : elle devient une
    bande pleine largeur posée sous le fil d'Ariane, à la proportion de la
    photographie elle-même (--ratio-tete). C'est la même langue que le hero de
    l'accueil et du studio — image bord à bord, texte dessous — et le premier
    écran d'une page savoir-faire montre enfin un objet gravé.

    Le fil d'Ariane reste en tête : il annonce où l'on est avant de montrer
    quoi que ce soit. Il est extrait de sa colonne par « display: contents »,
    qui laisse ses frères et sœurs se réordonner sans toucher au balisage ni au
    dessin desktop.
  */
  .tete__grille {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .tete__copie {
    display: contents;
  }

  .tete__copie :global(.fil-ariane) {
    order: 1;
    margin-block-end: var(--e-m);
  }

  .tete__media {
    order: 2;
    overflow: hidden;
    background-color: var(--c-fond-creux);
    /* Bord à bord : sous 1560 px l'enveloppe vaut 100% - 2 gouttières. */
    margin-inline: calc(var(--gouttiere) * -1);
    margin-block-end: var(--e-l);
    aspect-ratio: var(--ratio-tete, 4 / 3);
    /* Une bande, jamais un mur : sur tablette la proportion native de
       certaines sources donnerait 850 px de haut. Au-delà, le cadrage se
       resserre au lieu de repousser le texte hors du premier écran. */
    max-block-size: min(62vh, 36rem);
  }

  /*
    Le ratio est porté par l'image, pas par le <picture> : sur un <picture>,
    « aspect-ratio » ne gouverne pas la hauteur de l'image qu'il contient.
  */
  .tete__media :global(picture) {
    display: contents;
  }

  .tete__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .tete__copie .surtitre,
  .tete__copie h1,
  .tete__copie .chapo,
  .tete__copie .boutons,
  .tete__points {
    order: 3;
  }

  .tete__copie h1 {
    margin-block: var(--e-2xs) var(--e-m);
    max-width: 16ch;
    font-size: var(--t-5);
  }

  .tete__copie .chapo {
    margin-block-end: var(--e-l);
  }

  .tete__points {
    display: grid;
    gap: 0;
    inline-size: 100%;
    margin-block-start: var(--e-l);
    list-style: none;
    padding: 0;
  }

  .tete__points li {
    padding-block: var(--e-xs);
    border-block-start: 1px solid var(--c-filet);
    color: var(--c-encre-douce);
    font-size: var(--t--1);
  }

  .tete__points li:last-child {
    border-block-end: 1px solid var(--c-filet);
  }

  @media (min-width: 64rem) {
    .tete__grille {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: var(--e-2xl);
      align-items: center;
    }

    .tete__copie {
      display: flex;
      flex-direction: column;
      align-items: start;
    }

    .tete__copie :global(.fil-ariane) {
      margin-block-end: var(--e-l);
    }

    .tete__media {
      margin-inline: 0;
      margin-block-end: 0;
      border-radius: var(--r-l);
      max-block-size: none;
    }
  }

  /* ---------- Corps rédactionnel ---------- */

  .contenu :global(h2) {
    margin-block-start: var(--e-xl);
    font-size: var(--t-3);
  }

  .contenu :global(h3) {
    margin-block-start: var(--e-l);
    font-size: var(--t-1);
  }

  .contenu :global(table) {
    inline-size: 100%;
    margin-block: var(--e-m);
    border-collapse: collapse;
    font-size: var(--t--1);
  }

  .contenu :global(th),
  .contenu :global(td) {
    padding: 0.7rem 0.9rem;
    border-block-end: 1px solid var(--c-filet);
    text-align: start;
    vertical-align: top;
  }

  .contenu :global(th) {
    color: var(--c-encre);
    font-weight: 600;
    border-block-end-color: var(--c-filet-fort);
  }

  .contenu :global(ol) {
    counter-reset: pas;
    list-style: none;
    padding-inline-start: 0;
  }

  .contenu :global(ol li) {
    counter-increment: pas;
    padding-inline-start: 2.25rem;
    position: relative;
  }

  .contenu :global(ol li)::before {
    content: counter(pas, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 0;
    color: var(--c-encre-muette);
    font-family: var(--f-titre);
    font-style: italic;
  }

  /* Le tableau doit défiler seul plutôt que déborder la page. */
  .contenu {
    overflow-wrap: break-word;
  }

  .suite {
    margin-block-start: var(--e-xl);
    text-align: center;
  }

  /* ---------- Prix et délai ---------- */

  .reperes {
    background-color: var(--c-fond-creux);
  }

  .reperes__titre {
    margin-block-end: var(--e-l);
    max-width: 22ch;
    font-size: var(--t-3);
  }

  .reperes__grille {
    display: grid;
    gap: var(--e-l);
  }

  @media (min-width: 52rem) {
    .reperes__grille {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--e-2xl);
    }
  }

  .reperes__liste {
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--c-filet-fort);
  }

  .reperes__liste li {
    padding-block: var(--e-xs);
    border-block-end: 1px solid var(--c-filet);
    color: var(--c-encre);
    font-size: var(--t-0);
  }

  .reperes__texte {
    display: grid;
    gap: var(--e-s);
    justify-items: start;
    align-content: start;
    max-width: 46ch;
    color: var(--c-encre-douce);
    line-height: 1.65;
  }

  .reperes__chiffrage {
    color: var(--c-encre);
    font-weight: 500;
  }

  /* ---------- Autres savoir-faire ---------- */

  .autres {
    display: grid;
    gap: var(--e-s);
    margin-block-start: var(--e-m);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 44rem) {
    .autres {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .autres {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .autres a {
    display: grid;
    gap: var(--e-3xs);
    block-size: 100%;
    padding: var(--e-s) var(--e-m);
    border: 1px solid var(--c-filet);
    border-radius: var(--r-l);
    text-decoration: none;
    transition: border-color var(--duree) var(--courbe);
  }

  .autres a:hover {
    border-color: var(--c-encre);
  }

  .autres strong {
    font-family: var(--f-titre);
    font-size: var(--t-1);
    font-weight: 400;
  }

  .autres span {
    color: var(--c-encre-muette);
    font-size: var(--t--2);
    line-height: 1.5;
  }
</style>
