---
import Base from '@layouts/Base.astro';
import FilAriane from '@components/FilAriane.astro';
import { adresse, email, legal, site, telephone } from '@data/site';
import { urlAbsolue } from '@utils/env';
import { filAriane, graphe, organisation, pageWeb } from '@utils/schema';

const chemin = '/mentions-legales/';
const url = urlAbsolue(chemin);
const titre = 'Mentions légales | Beaune Gravure';
const description =
  'Mentions légales du site beaunegravure.fr : éditeur, coordonnées, hébergeur, propriété intellectuelle et crédits photographiques.';

const miettes = [
  { nom: 'Accueil', href: '/' },
  { nom: 'Mentions légales', href: chemin },
];

const schema = graphe([
  organisation('/og/beaune-gravure-partage.jpg'),
  pageWeb({ url, titre, description }),
  filAriane(miettes),
]);

/**
 * Les mentions obligatoires dont la valeur n'a pas été communiquée sont
 * affichées comme telles plutôt que devinées. Publier une immatriculation
 * inventée serait plus grave que d'afficher une ligne à compléter.
 */
const identite = [
  { label: 'Dénomination sociale', valeur: legal.raisonSociale },
  { label: 'Forme juridique', valeur: legal.formeJuridique },
  { label: 'Siège social', valeur: `${adresse.rue}, ${adresse.codePostal} ${adresse.ville}, ${adresse.pays}` },
  { label: 'Téléphone', valeur: telephone.affichage },
  { label: 'Adresse e-mail', valeur: email },
  { label: 'Directeur de la publication', valeur: legal.directeurPublication },
  { label: 'Numéro SIRET', valeur: legal.siret },
  { label: 'Immatriculation RCS', valeur: legal.rcs },
  { label: 'Capital social', valeur: legal.capitalSocial },
  { label: 'N° de TVA intracommunautaire', valeur: legal.tvaIntracommunautaire },
];
---

<Base titre={titre} description={description} chemin={chemin} schema={schema}>
  <header class="section section--serree entete-page">
    <div class="enveloppe--texte">
      <FilAriane miettes={miettes} />
      <h1>Mentions légales</h1>
      <p class="chapo">
        Informations légales relatives au site {site.nom}, conformément à l’article 6-III
        de la loi n° 2004-575 du 21 juin 2004 pour la confiance dans l’économie numérique.
      </p>
    </div>
  </header>

  <div class="section section--serree">
    <div class="enveloppe--texte prose legal">
      <h2>Éditeur du site</h2>
      <dl class="identite">
        {
          identite.map((ligne) => (
            <div>
              <dt>{ligne.label}</dt>
              <dd>
                {ligne.valeur ?? (
                  <em class="manquant">Information à compléter avant mise en ligne</em>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <h2>Hébergement</h2>
      <p>
        Le site est hébergé par <strong>{legal.hebergeur.nom}</strong>,
        {' '}{legal.hebergeur.adresse} —
        <a href={legal.hebergeur.site} rel="noopener noreferrer" target="_blank">
          {legal.hebergeur.site.replace('https://', '')}
        </a>.
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L’ensemble des contenus du site — textes, photographies, mise en page,
        identité graphique — est la propriété de {legal.raisonSociale}, sauf mention
        contraire. Toute reproduction, représentation ou diffusion, totale ou
        partielle, sans autorisation écrite préalable est interdite.
      </p>
      <p>
        Les marques, logos et signes distinctifs visibles sur certaines photographies
        de réalisations demeurent la propriété exclusive de leurs titulaires
        respectifs. Ils sont reproduits à titre d’illustration du travail effectué par
        l’atelier et ne constituent ni un partenariat, ni une garantie, ni un
        quelconque droit d’usage cédé à un tiers.
      </p>

      <h2>Crédits photographiques</h2>
      <p>
        Sauf indication contraire, les photographies publiées sur ce site représentent
        des pièces réellement produites par l’atelier et ont été réalisées par
        {' '}{legal.raisonSociale}.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement des données transmises via le formulaire de contact est décrit
        dans la <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
      </p>

      <h2>Liens hypertextes</h2>
      <p>
        Le site comporte des liens vers des ressources externes (Google Maps, Instagram).
        {' '}{legal.raisonSociale} n’exerce aucun contrôle sur ces sites et décline toute
        responsabilité quant à leur contenu ou à l’usage qui pourrait en être fait.
      </p>

      <h2>Droit applicable</h2>
      <p>
        Le présent site est soumis au droit français. Tout litige relatif à son
        utilisation relève de la compétence des tribunaux français.
      </p>

      <h2>Signaler un contenu</h2>
      <p>
        Pour toute question ou demande relative au contenu de ce site, écrivez à
        <a href={`mailto:${email}`}>{email}</a> ou appelez le
        <a href={`tel:${telephone.e164}`}>{telephone.affichage}</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .entete-page .fil-ariane {
    margin-block-end: var(--e-l);
  }

  .entete-page h1 {
    margin-block-end: var(--e-m);
  }

  .legal h2 {
    margin-block-start: var(--e-xl);
    font-size: var(--t-2);
  }

  .identite {
    display: grid;
    gap: 0;
    margin-block: var(--e-m);
    border-block-start: 1px solid var(--c-filet);
  }

  .identite > div {
    display: grid;
    gap: var(--e-3xs);
    padding-block: var(--e-xs);
    border-block-end: 1px solid var(--c-filet);
  }

  @media (min-width: 40rem) {
    .identite > div {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
      gap: var(--e-m);
    }
  }

  .identite dt {
    color: var(--c-encre);
    font-size: var(--t--1);
    font-weight: 600;
  }

  .identite dd {
    margin: 0;
    color: var(--c-encre-douce);
    font-size: var(--t--1);
  }

  .manquant {
    color: var(--c-erreur);
    font-style: italic;
  }
</style>
