---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import FilAriane from '@components/FilAriane.astro';
import GrilleRealisations from '@components/GrilleRealisations.astro';
import SectionDevis from '@components/SectionDevis.astro';
import {
  CATEGORIES,
  categoriesOrdonnees,
  imagesDeclarees,
  parCategorie,
  realisations,
  type CategorieSlug,
} from '@data/realisations';
import { urlAbsolue } from '@utils/env';
import { filAriane, graphe, listeImages, organisation, pageWeb } from '@utils/schema';

export function getStaticPaths() {
  return (Object.keys(CATEGORIES) as CategorieSlug[]).map((slug) => ({
    params: { categorie: slug },
    props: { slug },
  }));
}

interface Props {
  slug: CategorieSlug;
}

const { slug } = Astro.props;
const categorie = CATEGORIES[slug];
const pieces = parCategorie(slug);

// Savoir-faire réellement rattachés aux pièces de cette catégorie.
const cheminsServices = [...new Set(pieces.map((p) => p.service).filter(Boolean))];
const services = (await getCollection('services')).filter((service) =>
  cheminsServices.includes(`/services/${service.id}/`),
);

const chemin = `/realisations/${slug}/`;
const url = urlAbsolue(chemin);
const titre = `${categorie.titre} | Beaune Gravure`;
const description = categorie.description;

const miettes = [
  { nom: 'Accueil', href: '/' },
  { nom: 'Réalisations', href: '/realisations/' },
  { nom: categorie.nom, href: chemin },
];

const schema = graphe([
  organisation('/og/beaune-gravure-partage.jpg'),
  pageWeb({ url, titre, description }),
  filAriane(miettes),
  // La page EST une liste de pièces : la déclarer comme telle ne crée aucune
  // structure artificielle, elle décrit ce que le visiteur voit.
  listeImages({
    url,
    nom: categorie.titre,
    description: categorie.description,
    images: await imagesDeclarees(pieces),
  }),
]);
---

<Base titre={titre} description={description} chemin={chemin} schema={schema}>
  <header class="section section--serree entete-page">
    <div class="enveloppe--large">
      <FilAriane miettes={miettes} />
      <p class="surtitre">Réalisations</p>
      <h1>{categorie.titre}</h1>
      <p class="chapo">{categorie.description}</p>

      <nav class="filtres" aria-label="Catégories de réalisations">
        <a href="/realisations/">
          Toutes les réalisations
          <span aria-hidden="true"> ({realisations.length})</span>
        </a>
        {
          categoriesOrdonnees.map((autre) =>
            autre.slug === slug ? (
              <span class="filtres__actif" aria-current="page">
                {autre.nom}
                <span aria-hidden="true"> ({autre.total})</span>
              </span>
            ) : (
              <a href={`/realisations/${autre.slug}/`}>
                {autre.nom}
                <span aria-hidden="true"> ({autre.total})</span>
              </a>
            ),
          )
        }
      </nav>
    </div>
  </header>

  <div class="section section--serree">
    <div class="enveloppe--large">
      <GrilleRealisations realisations={pieces} colonnes={3} prioritaires={3} />
    </div>
  </div>

  {/*
    Placé après la grille, et non avant : sur ces pages, ce sont les pièces qui
    parlent en premier. Le texte vient répondre à la question que la grille fait
    naître — qu'est-ce que ces photographies ont en commun, et dans quels cas
    ces pièces sont-elles commandées.
  */}
  <section class="section section--serree contexte">
    <div class="enveloppe contexte__grille">
      <div>
        <p class="surtitre">Ce que montre cette catégorie</p>
        <p class="contexte__intro">{categorie.intro}</p>
      </div>
      <div class="contexte__usages">
        <p class="contexte__etiquette">Le plus souvent commandées pour</p>
        <p>{categorie.usages}</p>
        {
          'voirAussi' in categorie && (
            <a class="lien-fleche" href={categorie.voirAussi.href}>
              {categorie.voirAussi.libelle}
            </a>
          )
        }
      </div>
    </div>
  </section>

  {
    services.length > 0 && (
      <section class="section section--creuse">
        <div class="enveloppe">
          <p class="surtitre">Savoir-faire associés</p>
          <ul class="associes">
            {services.map((service) => (
              <li>
                <a href={`/services/${service.id}/`}>
                  <strong>{service.data.titre}</strong>
                  <span>{service.data.chapo}</span>
                  <span class="lien-fleche">{service.data.titre} en détail</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <SectionDevis />
</Base>

<style>
  .entete-page .fil-ariane {
    margin-block-end: var(--e-l);
  }

  .entete-page h1 {
    margin-block: var(--e-2xs) var(--e-m);
    max-width: 18ch;
  }

  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2xs);
    margin-block-start: var(--e-xl);
  }

  .filtres a,
  .filtres__actif {
    display: inline-block;
    padding: 0.55em 1.1em;
    border: 1px solid var(--c-filet);
    border-radius: var(--r-m);
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duree) var(--courbe), color var(--duree) var(--courbe);
  }

  .filtres a:hover {
    border-color: var(--c-encre);
    color: var(--c-encre);
  }

  .filtres__actif {
    border-color: var(--c-encre);
    background-color: var(--c-encre);
    color: var(--c-fond);
  }

  /* ------------------------- Ce que montre la page ------------------------ */

  .contexte__grille {
    display: grid;
    gap: var(--e-l);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .contexte__grille {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--e-2xl);
    }
  }

  .contexte__intro {
    margin-block-start: var(--e-s);
    max-width: 54ch;
    color: var(--c-encre);
    font-size: var(--t-1);
    line-height: 1.55;
  }

  .contexte__usages {
    display: grid;
    gap: var(--e-2xs);
    justify-items: start;
    max-width: 48ch;
    padding-block-start: var(--e-s);
    border-block-start: 1px solid var(--c-filet-fort);
    color: var(--c-encre-douce);
    line-height: 1.65;
  }

  .contexte__etiquette {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contexte__usages .lien-fleche {
    margin-block-start: var(--e-xs);
  }

  /* -------------------------- Savoir-faire associés ------------------------ */

  .associes {
    display: grid;
    gap: var(--e-m);
    margin-block-start: var(--e-m);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 44rem) {
    .associes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .associes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .associes a {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--e-2xs);
    block-size: 100%;
    padding: var(--e-m);
    border: 1px solid var(--c-filet);
    border-radius: var(--r-l);
    background-color: var(--c-blanc);
    text-decoration: none;
    transition: border-color var(--duree) var(--courbe);
  }

  .associes a:hover {
    border-color: var(--c-encre);
  }

  .associes strong {
    font-family: var(--f-titre);
    font-size: var(--t-1);
    font-weight: 400;
  }

  .associes span:not(.lien-fleche) {
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    line-height: 1.55;
  }

  .associes .lien-fleche {
    margin-block-start: auto;
    padding-block-start: var(--e-xs);
  }
</style>
