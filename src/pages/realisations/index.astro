---
import Base from '@layouts/Base.astro';
import FilAriane from '@components/FilAriane.astro';
import GrilleRealisations from '@components/GrilleRealisations.astro';
import SectionDevis from '@components/SectionDevis.astro';
import {
  categoriesOrdonnees,
  imagesDeclarees,
  realisations,
  sousGaleriesDe,
} from '@data/realisations';
import { urlAbsolue } from '@utils/env';
import { filAriane, graphe, listeImages, organisation, pageWeb } from '@utils/schema';

const chemin = '/realisations/';
const url = urlAbsolue(chemin);
const titre = 'Réalisations : verres, coffrets et objets gravés | Beaune Gravure';
const description =
  'Les réalisations de l’atelier Beaune Gravure : verres gravés, caisses de vin, plaques, objets personnalisés et marquage industriel. Photographies de pièces réelles.';

const miettes = [
  { nom: 'Accueil', href: '/' },
  { nom: 'Réalisations', href: chemin },
];

/**
 * Les galeries thématiques, regroupées par catégorie.
 *
 * Elles n'étaient atteignables qu'en passant par une page de catégorie, soit
 * trois clics depuis l'accueil. Les lister ici les ramène à deux, et surtout
 * les rattache à une page déjà explorée : un moteur qui relit celle-ci les
 * découvre toutes d'un coup, au lieu d'attendre qu'il repasse sur les six
 * catégories une par une. Rien n'est inventé — ce sont les mêmes galeries,
 * déjà vérifiées au build par `sousGaleriesVerifiees`.
 *
 * `decoupe` n'en a aucune et disparaît naturellement du regroupement.
 */
const famillesParCategorie = categoriesOrdonnees
  .map((categorie) => ({ categorie, galeries: sousGaleriesDe(categorie.slug) }))
  .filter((groupe) => groupe.galeries.length > 0);

const schema = graphe([
  organisation('/og/beaune-gravure-partage.jpg'),
  pageWeb({ url, titre, description }),
  filAriane(miettes),
  // La page EST la liste complète des pièces photographiées : la déclarer comme
  // telle décrit ce que le visiteur voit, sans rien ajouter d'artificiel.
  listeImages({
    url,
    nom: `Réalisations de l’atelier Beaune Gravure`,
    description,
    images: await imagesDeclarees(realisations),
  }),
]);
---

<Base titre={titre} description={description} chemin={chemin} schema={schema}>
  <header class="section section--serree entete-page">
    <div class="enveloppe--large">
      <FilAriane miettes={miettes} />
      <p class="surtitre">Réalisations</p>
      <h1>{realisations.length} pièces sorties de l’atelier.</h1>
      <p class="chapo">
        Chaque photographie de cette page montre une pièce réellement produite ici.
        Aucun visuel de catalogue, aucune image de synthèse. Les logos visibles
        appartiennent à leurs propriétaires et illustrent le travail effectué.
      </p>
      <p class="entete-page__renvoi">
        <a class="lien-fleche" href="/a-propos/">L’atelier où elles ont été faites</a>
      </p>

      <nav class="filtres" aria-label="Catégories de réalisations">
        <span class="filtres__actif" aria-current="page">
          Toutes les réalisations
          <span aria-hidden="true"> ({realisations.length})</span>
        </span>
        {
          categoriesOrdonnees.map((categorie) => (
            <a href={`/realisations/${categorie.slug}/`}>
              {categorie.nom}
              <span aria-hidden="true"> ({categorie.total})</span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  {/*
    Placé avant la grille : soixante-deux pièces d'affilée, c'est beaucoup à
    parcourir quand on cherche des couteaux de sommelier ou des caisses de vin.
    Le raccourci vient donc en premier.
  */}
  <section class="section section--serree familles">
    <div class="enveloppe--large">
      <p class="surtitre">Par famille de pièces</p>
      <div class="familles__groupes">
        {
          famillesParCategorie.map(({ categorie, galeries }) => (
            <div class="familles__groupe">
              <h2 class="familles__categorie">
                <a href={`/realisations/${categorie.slug}/`}>{categorie.nom}</a>
              </h2>
              <ul class="familles__liste">
                {galeries.map((galerie) => (
                  <li>
                    <a href={`/realisations/${categorie.slug}/${galerie.slug}/`}>
                      <strong>{galerie.nom}</strong>
                      <span class="familles__compte">{galerie.pieces.length} pièces</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="section section--serree">
    <div class="enveloppe--large">
      <GrilleRealisations realisations={realisations} colonnes={3} prioritaires={3} />
    </div>
  </div>

  <SectionDevis
    surtitre="Votre pièce"
    titre="Vous avez un support en tête ? Montrez-le-nous."
    texte="Une photo, les dimensions et la quantité suffisent pour savoir si le projet est réalisable et à quelles conditions."
  />
</Base>

<style>
  .entete-page__renvoi {
    margin-block-start: var(--e-m);
  }

  .entete-page .fil-ariane {
    margin-block-end: var(--e-l);
  }

  .entete-page h1 {
    margin-block: var(--e-2xs) var(--e-m);
    max-width: 16ch;
  }

  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2xs);
    margin-block-start: var(--e-xl);
  }

  .filtres a,
  .filtres__actif {
    display: inline-block;
    padding: 0.55em 1.1em;
    border: 1px solid var(--c-filet);
    border-radius: var(--r-m);
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--duree) var(--courbe), color var(--duree) var(--courbe);
  }

  .filtres a:hover {
    border-color: var(--c-encre);
    color: var(--c-encre);
  }

  .filtres__actif {
    border-color: var(--c-encre);
    background-color: var(--c-encre);
    color: var(--c-fond);
  }

  /* ------------------------ Galeries thématiques -------------------------- */

  .familles__groupes {
    display: grid;
    gap: var(--e-l);
    margin-block-start: var(--e-m);
  }

  @media (min-width: 48rem) {
    .familles__groupes {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: var(--e-xl) var(--e-l);
    }
  }

  .familles__categorie {
    margin: 0;
    font-size: var(--t--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .familles__categorie a {
    color: var(--c-encre-muette);
    text-decoration: none;
    transition: color var(--duree) var(--courbe);
  }

  .familles__categorie a:hover {
    color: var(--c-encre);
  }

  .familles__liste {
    display: grid;
    gap: var(--e-s);
    margin-block-start: var(--e-s);
    padding: 0;
    list-style: none;
  }

  .familles__liste a {
    display: grid;
    gap: var(--e-3xs);
    padding-block-start: var(--e-2xs);
    border-block-start: 1px solid var(--c-filet);
    text-decoration: none;
    transition: border-color var(--duree) var(--courbe);
  }

  .familles__liste a:hover {
    border-block-start-color: var(--c-encre);
  }

  .familles__liste strong {
    color: var(--c-encre);
    font-weight: 600;
  }

  .familles__compte {
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.06em;
    color: var(--c-encre-muette);
  }
</style>
