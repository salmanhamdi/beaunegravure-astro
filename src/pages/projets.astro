---
import { Picture } from 'astro:assets';
import Base from '@layouts/Base.astro';
import FilAriane from '@components/FilAriane.astro';
import SectionDevis from '@components/SectionDevis.astro';
import { projets } from '@data/projets';
import { urlAbsolue } from '@utils/env';
import { filAriane, graphe, organisation, pageWeb } from '@utils/schema';

const chemin = '/projets/';
const url = urlAbsolue(chemin);
const titre = 'Nos projets : Glassora et Spotitap | Beaune Gravure';
const description =
  'Glassora et Spotitap sont deux marques conçues et fabriquées par Beaune Gravure : une maison de verrerie gravée et une gamme de plaques NFC connectées.';

const miettes = [
  { nom: 'Accueil', href: '/' },
  { nom: 'Projets', href: chemin },
];

const schema = graphe([
  organisation('/og/beaune-gravure-partage.jpg'),
  pageWeb({ url, titre, description }),
  filAriane(miettes),
  // Les deux marques sont déclarées comme des marques distinctes, dont
  // Beaune Gravure est à l'origine. Elles ne sont pas des services.
  ...projets.map((projet) => ({
    '@type': 'Brand',
    '@id': `${url}#${projet.slug}`,
    name: projet.nom,
    description: projet.description,
    url: projet.url,
    parentOrganization: { '@id': urlAbsolue('/#organization') },
  })),
]);
---

<Base titre={titre} description={description} chemin={chemin} schema={schema}>
  <header class="section section--serree entete-page">
    <div class="enveloppe">
      <FilAriane miettes={miettes} />
      <p class="surtitre">Projets</p>
      <h1>Un studio. Des savoir-faire. Des projets.</h1>
      <p class="chapo">
        Une partie de notre travail consiste à répondre à des commandes. Une autre
        consiste à concevoir nos propres produits, à les fabriquer et à les mener
        jusqu’au marché. Deux marques en sont issues.
      </p>
    </div>
  </header>

  <div class="section section--serree">
    <div class="enveloppe">
      {
        projets.map((projet, index) => (
          <article class="projet revele" id={projet.slug}>
            <div class="projet__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </div>

            <div class="projet__corps">
              <p class="projet__nature">{projet.nature}</p>
              <h2>{projet.nom}</h2>
              <p class="projet__accroche">{projet.accroche}</p>

              {/*
                La preuve photographique vient AVANT le récit, pas après.
                Reléguée sous les trois étapes, elle n'apparaissait qu'à
                1 469 px sur desktop et 1 598 px sur téléphone : une page de
                projets qui ne montrait rien avant d'avoir tout raconté. Le
                récit en trois temps, les repères et le lien sortant restent
                intacts en dessous — la page ne devient pas une galerie, elle
                pose sa preuve à l'ouverture du dossier.
              */}
              <figure class="projet__preuve">
                <Picture
                  src={projet.visuel}
                  alt={projet.visuelAlt}
                  widths={[400, 640, 900, 1086]}
                  sizes="(min-width: 56rem) 34rem, 92vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  quality={72}
                  formats={['avif']}
                  fallbackFormat="webp"
                />
                <figcaption>{projet.visuelLegende}</figcaption>
              </figure>

              <div class="projet__texte">
                <p>{projet.description}</p>
              </div>

              {/*
                Le projet en trois temps. C'est ce qui sépare une page de
                marque d'une page de preuve : d'où l'on part, ce qui a été
                réellement fait, et ce que cela démontre.
              */}
              <ol class="etapes">
                <li>
                  <span class="etapes__titre">Le point de départ</span>
                  <p>{projet.contexte}</p>
                </li>
                <li>
                  <span class="etapes__titre">Ce que l’atelier a fait</span>
                  <p>{projet.atelier}</p>
                </li>
                <li>
                  <span class="etapes__titre">Ce que le projet démontre</span>
                  <p>{projet.resultat}</p>
                </li>
              </ol>

              <ul class="projet__reperes">
                {projet.reperes.map((repere) => (
                  <li>{repere}</li>
                ))}
              </ul>

              <div class="projet__savoirs">
                <p class="projet__savoirs-etiquette">Les savoir-faire mobilisés</p>
                <ul>
                  {projet.savoirFaire.map((lien) => (
                    <li>
                      <a class="lien-fleche" href={lien.href}>
                        {lien.libelle}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <a class="bouton" href={projet.url} rel="noopener" target="_blank">
                {projet.libelleLien}
                <span class="visuellement-cache"> — {projet.domaine}, nouvel onglet</span>
              </a>
              <p class="projet__domaine">{projet.domaine}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <section class="section sur-nuit pourquoi">
    <div class="enveloppe pourquoi__grille">
      <div>
        <p class="surtitre">Pourquoi cela vous concerne</p>
        <h2>Mener un produit jusqu’au bout, ça s’apprend en le faisant.</h2>
      </div>
      <div class="pourquoi__texte">
        <p>
          Concevoir une gamme, choisir des fournisseurs, tenir une qualité constante sur
          des centaines de pièces, gérer un service après-vente : ce sont des contraintes
          que l’on ne rencontre pas en exécutant des commandes une par une.
        </p>
        <p>
          C’est cette expérience que nous remettons dans vos projets — qu’il s’agisse de
          dix pièces ou d’une gamme complète à imaginer.
        </p>
        <div class="pourquoi__liens">
          <a class="lien-fleche" href="/services/creation-graphique/">
            Notre travail de conception
          </a>
          <a class="lien-fleche" href="/a-propos/">
            L’atelier et ses machines
          </a>
        </div>
      </div>
    </div>
  </section>

  <SectionDevis
    surtitre="Un produit à développer ?"
    titre="Parlons-en avant que le premier fichier ne soit dessiné."
    texte="Conception, choix des matières, prototype, série : plus la discussion démarre tôt, moins le projet coûte cher à corriger."
  />
</Base>

<style>
  .entete-page .fil-ariane {
    margin-block-end: var(--e-l);
  }

  .entete-page h1 {
    margin-block: var(--e-2xs) var(--e-m);
    max-width: 20ch;
  }

  /* ------------------------------ Projet ------------------------------ */

  .projet {
    display: grid;
    gap: var(--e-s);
    padding-block: var(--e-xl);
    border-block-start: 1px solid var(--c-filet-fort);
  }

  .projet:last-child {
    border-block-end: 1px solid var(--c-filet-fort);
  }

  @media (min-width: 56rem) {
    .projet {
      grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
      gap: var(--e-xl);
    }
  }

  .projet__index {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--1);
  }

  .projet__corps {
    display: flex;
    flex-direction: column;
    align-items: start;
    max-width: 62rem;
  }

  /*
    À partir de 64rem, la preuve passe en colonne de droite, à hauteur du nom
    du projet. Elle est alors visible dès l'ouverture de la page — 823 px de
    haut de page en moins — sans qu'une seule ligne du récit soit déplacée, et
    elle occupe la marge droite que la colonne de texte laissait vide. Le
    dossier reste un dossier : contexte, atelier, résultat, repères et lien
    sortant se lisent dans le même ordre qu'avant.
  */
  @media (min-width: 64rem) {
    .projet__corps {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      column-gap: var(--e-2xl);
      row-gap: 0;
      align-content: start;
      justify-items: start;
      max-width: none;
    }

    /*
      Sélecteurs disjoints et non « > * » suivi d'une exception : la
      minification réordonne les règles de même spécificité, et l'exception se
      faisait alors écraser par la règle générale.
    */
    .projet__corps > :not(.projet__preuve) {
      grid-column: 1;
    }

    .projet__corps > .projet__preuve {
      grid-column: 2;
      /* Ancrée en haut de la colonne, sans étirer aucune ligne du récit. */
      grid-row: 1 / span 12;
      align-self: start;
      margin-block: 0;
      max-width: none;
    }
  }

  .projet__nature {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .projet h2 {
    margin-block: var(--e-2xs) var(--e-xs);
    font-size: var(--t-4);
  }

  .projet__accroche {
    max-width: 46ch;
    color: var(--c-encre);
    font-size: var(--t-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .projet__texte {
    display: grid;
    gap: var(--e-s);
    margin-block: var(--e-m);
    max-width: 62ch;
    color: var(--c-encre-douce);
  }

  /* Le projet en trois temps. La numérotation reprend celle des projets
     eux-mêmes : un filet à gauche, un compteur discret, aucune décoration. */
  .etapes {
    display: grid;
    gap: var(--e-m);
    inline-size: 100%;
    max-width: 62ch;
    margin-block-end: var(--e-l);
    counter-reset: etape;
    list-style: none;
    padding: 0;
  }

  .etapes li {
    counter-increment: etape;
    padding-inline-start: var(--e-m);
    border-inline-start: 2px solid var(--c-filet-fort);
    color: var(--c-encre-douce);
  }

  .etapes li:first-child {
    border-inline-start-color: var(--c-encre);
  }

  .etapes__titre {
    display: block;
    margin-block-end: var(--e-3xs);
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .etapes__titre::before {
    content: counter(etape, decimal-leading-zero) ' · ';
  }

  /* Cadre imposé, comme partout ailleurs sur le site : ce sont les mêmes deux
     photographies que sur la page d'accueil, et elles y sont déjà cadrées en
     3/2. Les dimensions natives ne doivent pas décider de la mise en page —
     celle de Glassora est en portrait et occuperait sinon 725 px de haut. */
  .projet__preuve {
    inline-size: 100%;
    max-width: 34rem;
    margin-block: var(--e-m) var(--e-l);
  }

  /*
    Le ratio est porté par l'image, pas par le <picture> : sur un <picture>,
    « aspect-ratio » ne gouverne pas la hauteur de l'image qu'il contient, et
    le cadre reprenait la proportion native du fichier.
  */
  .projet__preuve :global(picture) {
    display: contents;
  }

  .projet__preuve :global(img) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--r-l);
    background-color: var(--c-fond-creux);
  }

  .projet__preuve figcaption {
    margin-block-start: var(--e-xs);
    max-width: 46ch;
    color: var(--c-encre-muette);
    font-size: var(--t--2);
    line-height: 1.55;
  }

  .projet__savoirs {
    inline-size: 100%;
    max-width: 42rem;
    margin-block-end: var(--e-l);
  }

  .projet__savoirs-etiquette {
    margin-block-end: var(--e-xs);
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .projet__savoirs ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2xs) var(--e-l);
    list-style: none;
    padding: 0;
  }

  .projet__reperes {
    inline-size: 100%;
    max-width: 42rem;
    margin-block-end: var(--e-m);
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--c-filet);
  }

  .projet__reperes li {
    padding-block: var(--e-xs);
    border-block-end: 1px solid var(--c-filet);
    color: var(--c-encre-douce);
    font-family: var(--f-mono);
    font-size: var(--t--2);
  }

  .projet__domaine {
    margin-block-start: var(--e-2xs);
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
  }

  /* ----------------------------- Pourquoi ----------------------------- */

  .pourquoi__grille {
    display: grid;
    gap: var(--e-l);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .pourquoi__grille {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--e-2xl);
    }
  }

  .pourquoi h2 {
    max-width: 18ch;
    font-size: var(--t-3);
  }

  .pourquoi__texte {
    display: grid;
    gap: var(--e-s);
    justify-items: start;
    max-width: 56ch;
    color: var(--c-encre-douce);
  }

  .pourquoi__liens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2xs) var(--e-l);
  }
</style>
