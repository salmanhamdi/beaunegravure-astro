---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import GrilleRealisations from '@components/GrilleRealisations.astro';
import HeroScene from '@components/HeroScene.astro';
import SectionDevis from '@components/SectionDevis.astro';
import { imagesRealisations, parIds, realisations } from '@data/realisations';
import { projets } from '@data/projets';
import { adresse, reseaux, site, zones } from '@data/site';
import { urlAbsolue } from '@utils/env';
import { graphe, organisation, pageWeb, siteWeb } from '@utils/schema';
import atelier from '@assets/images/atelier/atelier-laser-uv-beaune-gravure-hero.jpg';
import heroImage from '@assets/images/atelier/hero-accueil-decoupe-laser-plaque-beaune-gravure.jpg';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const creation = services.filter((s) => s.data.famille === 'creation');
const fabrication = services.filter((s) => s.data.famille === 'fabrication');
const applications = services.filter((s) => s.data.famille === 'application');

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime())
  .slice(0, 3);

/*
  Règle éditoriale de la page d'accueil : UNE IMAGE = UNE OCCURRENCE.
  Aucune photographie ne doit apparaître deux fois sur cette page. Les deux
  sélections ci-dessous et le héros sont donc disjoints, et le contrôle en est
  automatisé plus bas (`imagesAccueil`) : le build échoue si un doublon
  réapparaît.

  Réalisations : la question posée n'est pas « sur quelles matières
  travaillez-vous ? » — c'est la section Matières qui y répond — mais
  « qu'êtes-vous capables de créer ? ». Chaque vignette montre donc un usage
  différent : objet de série, signalétique posée, impression couleur, cadeau
  d'entreprise, découpe sur mesure, identité de marque.
*/
const selection = parIds(
  // La première pièce est mise en scène en grand : c'est celle qui prouve le
  // mieux la compétence graphique — une identité de commerce entière, dessinée
  // puis portée sur un objet.
  'badge-professionnel-grave-personnalise',
  'plaque-professionnelle-avocat-exterieure-beaune-gravure',
  'impression-uv-coffret-bois-mariage-personnalise',
  'cles-usb-bois-personnalisees-gravure',
  'decoupe-plexiglass-plaque-numero-porte',
  'gobelets-isothermes-personnalises-laser',
);

/*
  Matières : une pièce finie par matière, jamais une machine — le visiteur doit
  voir ce que l'atelier fabrique, pas l'outil qui le fabrique. La couleur
  naturelle de chaque matière fait partie de la démonstration : elle n'est plus
  désaturée.

  Le héros n'est plus une pièce finie mais la scène de fabrication : les six
  vignettes portent donc seules la démonstration des matières. Le cuir n'y
  figure pas — la seule photographie de cuir de l'atelier ne vaut pas les six
  retenues ici — et le liège prend la sixième vignette.
*/
const matieres = [
  { nom: 'Métal', detail: 'Inox, aluminium, laiton', id: 'pieces-inox-marquage-numero-serie' },
  { nom: 'Bois', detail: 'Massif, contreplaqué, placage', id: 'gravure-laser-panneau-bois-moto-club' },
  { nom: 'Verre', detail: 'Verrerie, trophées, cristal', id: 'trophee-verre-grave-personnalise' },
  { nom: 'Plexiglass', detail: 'PMMA coulé, extrudé, bicouche', id: 'medaillons-plexiglass-decoupes-graves' },
  { nom: 'Liège', detail: 'Liège, matières fines, textile', id: 'sous-verres-liege-graves-restauration' },
  { nom: 'Objets', detail: 'Outillage, accessoires, séries', id: 'stylos-bois-graves-cadeaux-entreprise' },
];

/* Le fichier devient une pièce : l'image de la section Savoir-faire. */
const visuelSavoir = imagesRealisations['decoupe-bois-prenoms-cercles-personnalises']!;

/* Le geste de fabrication : la seule image de la page qui touche les deux bords. */
const visuelAtelier = imagesRealisations['marquage-laser-fibre-outils-serie']!;

/*
  Garde-fou de la règle « une image = une occurrence ». Une erreur ici arrête le
  build : impossible de réintroduire un doublon sans s'en apercevoir.
*/
const imagesAccueil = [
  ...matieres.map((m) => m.id),
  ...selection.map((r) => r.id),
  'decoupe-bois-prenoms-cercles-personnalises',
  'marquage-laser-fibre-outils-serie',
];
const doublons = imagesAccueil.filter((id, i) => imagesAccueil.indexOf(id) !== i);
if (doublons.length > 0) {
  throw new Error(
    `Page d'accueil : image utilisée plusieurs fois — ${[...new Set(doublons)].join(', ')}`,
  );
}

const chaine = [
  {
    numero: '01',
    titre: 'Une idée',
    texte: 'Un besoin, une intuition, parfois une simple photo. Rien n’est encore dessiné.',
  },
  {
    numero: '02',
    titre: 'Une création',
    texte:
      'Le visuel est dessiné, vectorisé, adapté, simplifié. C’est ici que se joue la lisibilité finale.',
  },
  {
    numero: '03',
    titre: 'Une matière',
    texte:
      'Chaque support impose ses limites. Nous choisissons celle qui sert le projet, et le disons quand aucune ne convient.',
  },
  {
    numero: '04',
    titre: 'Une fabrication',
    texte:
      'Réglages, essai, production, contrôle. La pièce est vérifiée avant de sortir de l’atelier.',
  },
  {
    numero: '05',
    titre: 'Un objet',
    texte:
      'Livré, posé, offert ou mis en rayon. Et parfois, le point de départ d’une marque entière.',
  },
];

const url = urlAbsolue('/');
const titre = 'Beaune Gravure | Création, personnalisation, fabrication';
const description =
  'Studio de création, de personnalisation et de fabrication près de Beaune : création graphique, gravure et découpe laser, impression UV. De l’idée à l’objet fini.';

const schema = graphe([
  organisation('/og/beaune-gravure-partage.jpg'),
  siteWeb(),
  pageWeb({ url, titre, description }),
]);
---

<Base titre={titre} description={description} chemin="/" schema={schema}>
  <!-- ============================== Hero ============================== -->
  <HeroScene
    image={heroImage}
    alt="Tête de découpe laser rouge en action sur une plaque de plexiglass gravée au logo Beaune Gravure, dans l’atelier"
    surtitre="Création · Personnalisation · Fabrication"
    lignesTitre={['Des idées', 'qui prennent', 'forme.']}
    chapo="Gravure laser, découpe laser, impression UV et création graphique. Un studio équipé pour mener votre projet du dessin à la pièce finie — de l’exemplaire unique à la série."
    actions={[
      { texte: 'Découvrir nos savoir-faire', href: '/services/' },
      { texte: 'Demander un devis', href: '/contact/', fantome: true },
    ]}
    preuves={[
      { icone: 'precision', titre: 'Haute précision', detail: 'Technologies laser & UV' },
      { icone: 'series', titre: 'Pièces uniques ou séries', detail: 'De l’unité à la production' },
      { icone: 'accompagnement', titre: 'Accompagnement sur mesure', detail: 'Conseil et création graphique' },
    ]}
  />

  <!--
    Le bandeau n'est pas une frise décorative : c'est l'argument commercial
    central — « vous arrivez avec une idée, nous l'amenons jusqu'à l'objet ».
    Il est donc énoncé, puis décliné en cinq étapes lisibles. Il sort du héros
    depuis que celui-ci est une scène photographique pleine largeur.
  -->
  <section class="chaine-bandeau enveloppe--large">
    <p class="chaine-bandeau__annonce">
      Vous arrivez avec une idée.<br />
      <strong>Nous l’amenons jusqu’à l’objet.</strong>
    </p>
    <ol class="chaine-bandeau__liste" aria-label="Notre chaîne de valeur">
      <li>Idée</li>
      <li>Création</li>
      <li>Matière</li>
      <li>Fabrication</li>
      <li>Objet</li>
    </ol>
  </section>

  <!--
    ============================== Manifeste ==============================
    Premier moment pleine largeur de la page. La phrase n'est pas nouvelle :
    c'est celle qui distinguait déjà l'atelier, mais elle était composée en
    16 px gris dans une colonne de droite. Elle passe à l'échelle qu'elle
    mérite. Aucun contenu ajouté, un contenu déplacé et redimensionné.
  -->
  <section class="section section--serree manifeste sur-nuit">
    <div class="enveloppe--large">
      <p class="manifeste__phrase revele">
        La plupart des ateliers exécutent un fichier.
        <strong>Nous le dessinons aussi.</strong>
      </p>
      <p class="manifeste__suite">
        C’est cette continuité entre conception et fabrication qui fait la différence
        sur le résultat final.
      </p>
    </div>
  </section>

  <!-- ========================= Ce que nous faisons ===================== -->
  <section class="section trois">
    <div class="enveloppe">
      <div class="tete-section">
        <div>
          <p class="surtitre">Ce que nous faisons</p>
          <h2>Trois métiers, un seul interlocuteur.</h2>
        </div>
      </div>

      <div class="trois__grille">
        <article class="trois__bloc revele">
          <p class="trois__numero">01</p>
          <h3>Création</h3>
          <p>
            Vectorisation, adaptation de logo, composition, mise au format. Le visuel est
            préparé pour la matière avant d’approcher la machine.
          </p>
          <a class="lien-fleche" href="/services/creation-graphique/">La création graphique</a>
        </article>

        <article class="trois__bloc revele">
          <p class="trois__numero">02</p>
          <h3>Personnalisation</h3>
          <p>
            Un nom, un logo, une date, un numéro de série. Sur une pièce ou sur mille,
            avec la même régularité d’un exemplaire à l’autre.
          </p>
          <a class="lien-fleche" href="/realisations/">Les réalisations</a>
        </article>

        <article class="trois__bloc revele">
          <p class="trois__numero">03</p>
          <h3>Fabrication</h3>
          <p>
            Gravure laser, découpe, impression UV, assemblage. Et jusqu’à la conception
            d’un produit complet quand le projet le demande.
          </p>
          <a class="lien-fleche" href="/projets/">Nos projets</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================= Matières ============================ -->
  <section class="section section--creuse matieres">
    <div class="enveloppe--large">
      <div class="tete-section tete-section--duo">
        <div>
          <p class="surtitre">Les matières</p>
          <h2 class="titre-fort">Aucune matière<br />ne nous définit.</h2>
        </div>
        <p class="chapo">
          Chaque support réagit différemment au faisceau. C’est en connaissant ces
          différences — et en sachant dire quand une matière ne convient pas — que l’on
          obtient une pièce juste.
        </p>
      </div>

      <ul class="matieres__grille">
        {
          matieres.map((matiere) => (
            <li class="matieres__item revele">
              <div class="matieres__media">
                {/*
                  Le cadre est un portrait 4/5 alors que la plupart de ces
                  photographies sont en paysage : sans recadrage à la source,
                  « object-fit: cover » jette jusqu'aux deux tiers de la largeur
                  du fichier servi, et le peu qui reste est étiré. Les variantes
                  sont donc générées DÉJÀ recadrées — même cadrage à l'écran,
                  mais chaque pixel téléchargé est un pixel affiché.

                  Le « sizes » décrit la vraie case de la grille : trois
                  colonnes dans « enveloppe--large », et non 16vw.
                */}
                <Picture
                  src={imagesRealisations[matiere.id]!}
                  alt=""
                  width={560}
                  height={700}
                  fit="cover"
                  position="center"
                  widths={[280, 420, 560, 700, 840]}
                  sizes="(min-width: 100rem) 500px, (min-width: 68rem) 31vw, (min-width: 40rem) 30vw, 45vw"
                  loading="lazy"
                  quality={78}
                  formats={['avif']}
                  fallbackFormat="webp"
                />
              </div>
              <p class="matieres__nom">{matiere.nom}</p>
              <p class="matieres__detail">{matiere.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- =========================== Réalisations ========================== -->
  <section class="section realisations">
    <div class="enveloppe--large">
      <!--
        En-tête volontairement différent des autres : le titre occupe toute la
        largeur au lieu d'être suivi d'un chapô en colonne de droite. Six
        sections partageaient exactement la même composition ; la page en
        paraissait modelée sur un gabarit.
      -->
      <div class="realisations__entete">
        <p class="surtitre">Réalisations</p>
        <h2 class="titre-fort">Des pièces réellement<br />sorties de l’atelier.</h2>
        <div class="realisations__pied">
          <p class="realisations__note">
            Toutes les photographies de ce site montrent des pièces que nous avons
            produites. Aucun visuel de catalogue, aucune image de synthèse.
          </p>
          <p class="realisations__compte" aria-hidden="true">{realisations.length}</p>
        </div>
      </div>

      {/*
        Hiérarchie : la première pièce est mise en scène sur quatre cellules,
        les cinq autres suivent la grille régulière. L'asymétrie est décidée
        ici, pas subie par le format des fichiers — la vignette reste carrée.
      */}
      <GrilleRealisations realisations={selection} colonnes={3} vedette />

      <p class="suite">
        <a class="bouton bouton--fantome" href="/realisations/">
          Voir les {realisations.length} réalisations
        </a>
      </p>
    </div>
  </section>

  <!-- ====================== Appel à l'action intermédiaire ============== -->
  <!--
    Point de conversion précoce. Il arrive juste après la première preuve
    visuelle : le visiteur pressé peut s'arrêter là, le visiteur curieux
    continue. L'appel final reste en bas de page.
  -->
  <section class="section section--serree sur-nuit relance">
    <div class="enveloppe relance__grille">
      <p class="relance__titre">Vous avez un projet ?</p>
      <p class="relance__texte">
        Une photo, un croquis, un logo : c’est déjà suffisant pour en parler.
      </p>
      <a class="bouton bouton--inverse" href="/contact/">Parlons-en</a>
    </div>
  </section>

  <!-- ============================== Projets ============================ -->
  <section class="section section--creuse projets">
    <div class="enveloppe">
      <div class="tete-section tete-section--duo">
        <div>
          <p class="surtitre">Nos projets</p>
          <h2>Deux marques nées de l’atelier.</h2>
        </div>
        <p class="chapo">
          La preuve la plus directe de ce que nous savons faire n’est pas une référence
          client : ce sont deux marques que nous avons conçues, fabriquées et menées
          jusqu’au marché.
        </p>
      </div>

      <ul class="projets__liste">
        {
          projets.map((projet) => (
            <li class="projets__item revele">
              {/*
                Chaque projet montre désormais son propre produit, photographié
                à l'atelier. Le cadre est carré : en 3/2, le socle gravé
                « spotitap » sortait du cadre, et c'est lui qui porte la marque.
              */}
              <figure class="projets__visuel">
                <Picture
                  src={projet.visuel}
                  alt={projet.visuelAlt}
                  widths={[420, 640, 900, 1086]}
                  sizes="(min-width: 56rem) 44vw, 100vw"
                  loading="lazy"
                  quality={72}
                  formats={['avif']}
                  fallbackFormat="webp"
                />
              </figure>
              <p class="projets__nature">{projet.nature}</p>
              <h3>{projet.nom}</h3>
              <p class="projets__accroche">{projet.accroche}</p>
              <p class="projets__legende">{projet.visuelLegende}</p>
              <ul class="projets__reperes">
                {projet.reperes.map((repere) => (
                  <li>{repere}</li>
                ))}
              </ul>
              <a class="lien-fleche" href={projet.url} rel="noopener" target="_blank">
                {projet.libelleLien}
                <span class="visuellement-cache"> (nouvel onglet)</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="suite">
        <a class="bouton bouton--fantome" href="/projets/">Comment ces projets sont nés</a>
      </p>
    </div>
  </section>

  <!-- =========================== Savoir-faire ========================== -->
  <section class="section savoir">
    <div class="enveloppe">
      <!--
        Une seule image ici, et elle raconte l'enchaînement que la liste ne peut
        pas montrer : un prénom dessiné, vectorisé, puis découpé dans le bois,
        photographié sur le plateau de la machine. C'est la démonstration que le
        savoir-faire commence avant l'outil.
      -->
      <div class="savoir__entete">
        <div class="savoir__intro">
          <p class="surtitre">Savoir-faire</p>
          <h2>Des moyens, pas une identité.</h2>
          {/*
            Les `{' '}` sont indispensables : Astro supprime le retour à la ligne
            qui sépare un mot d'une balise ouvrante placée sur la ligne suivante.
            Sans eux, la page affichait « desrestaurants », « desindustriels » et
            « desdomaines ».
          */}
          <p class="savoir__clients">
            Nous travaillons pour des <strong>entreprises et des marques</strong>,
            des{' '}
            <strong>restaurants, hôtels et commerces</strong>, des{' '}
            <strong>industriels et bureaux d’études</strong>, des{' '}
            <strong>domaines viticoles</strong> et des <strong>particuliers</strong>.
          </p>
        </div>

        <figure class="savoir__visuel revele">
          <Picture
            src={visuelSavoir}
            alt="Prénoms découpés au laser dans du bois clair, posés sur le plateau de la machine"
            widths={[420, 640, 900]}
            sizes="(min-width: 56rem) 40vw, 100vw"
            loading="lazy"
            quality={72}
            formats={['avif']}
            fallbackFormat="webp"
          />
          <figcaption>
            Un prénom dessiné, vectorisé, puis découpé. La machine n’intervient
            qu’à la dernière étape.
          </figcaption>
        </figure>
      </div>

      <div class="savoir__famille">
        <p class="savoir__etiquette">Conception</p>
        <ul class="savoir__liste">
          {
            creation.map((service) => (
              <li>
                <a href={`/services/${service.id}/`}>
                  <span class="savoir__titre">{service.data.titre}</span>
                  <span class="savoir__texte">{service.data.usages}</span>
                  <span class="lien-fleche" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="savoir__famille">
        <p class="savoir__etiquette">Fabrication</p>
        <ul class="savoir__liste">
          {
            fabrication.map((service) => (
              <li>
                <a href={`/services/${service.id}/`}>
                  <span class="savoir__titre">{service.data.titre}</span>
                  <span class="savoir__texte">{service.data.usages}</span>
                  <span class="lien-fleche" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/*
        Les applications portaient un titre et rien d'autre : six lignes nues
        qui se lisaient comme un tarif. Elles affichent désormais le même
        repère d'usage que les autres familles — un contenu déjà présent dans
        le frontmatter de chaque page, rien n'est inventé.
      */}
      <div class="savoir__famille">
        <p class="savoir__etiquette">Applications</p>
        <ul class="savoir__liste">
          {
            applications.map((service) => (
              <li>
                <a href={`/services/${service.id}/`}>
                  <span class="savoir__titre">{service.data.titre}</span>
                  <span class="savoir__texte">{service.data.usages}</span>
                  <span class="lien-fleche" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!--
    ========================== Bandeau de fabrication ====================
    Seul moment de la page où une image touche les deux bords. Il introduit
    la chaîne « du dessin à l'objet » par la seule chose que la page ne
    montrait nulle part : le geste de fabrication. La photographie n'était
    utilisée sur aucune autre page d'accueil.
  -->
  <figure class="bandeau-atelier sur-nuit">
    <Picture
      src={visuelAtelier}
      alt="Main d’un opérateur au-dessus d’une série d’outils en acier alignés dans la machine de marquage"
      widths={[768, 1200, 1600]}
      sizes="100vw"
      loading="lazy"
      quality={70}
      formats={['avif']}
      fallbackFormat="webp"
    />
    <figcaption class="bandeau-atelier__legende">
      <span class="bandeau-atelier__marqueur">Atelier</span>
      Marquage d’une série d’outils : le réglage se fait sur la première pièce, le
      contrôle sur toutes les autres.
    </figcaption>
  </figure>

  <!-- ========================= Du dessin à l'objet ===================== -->
  <section class="section sur-nuit chaine">
    <div class="enveloppe">
      <div class="tete-section tete-section--duo">
        <div>
          <p class="surtitre">Du dessin à l’objet</p>
          <h2>Une idée ne devient pas un objet toute seule.</h2>
        </div>
        <p class="chapo">
          Entre les deux, il y a un dessin à préparer, une matière à choisir, des
          réglages à trouver et une pièce à contrôler. Nous couvrons toute la chaîne.
        </p>
      </div>

      <ol class="chaine__liste">
        {
          chaine.map((etape) => (
            <li class="chaine__etape revele">
              <span class="chaine__numero">{etape.numero}</span>
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================== Studio ============================= -->
  <section class="section studio">
    <div class="enveloppe studio__grille">
      <figure class="studio__media revele">
        <Picture
          src={atelier}
          alt="Poste de marquage laser du studio, avec son ordinateur de préparation et les lunettes de protection"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 56rem) 48vw, 92vw"
          loading="lazy"
          quality={72}
          formats={['avif']}
          fallbackFormat="webp"
        />
      </figure>
      <div class="studio__copie">
        <p class="surtitre">Le studio</p>
        <h2>Un atelier à taille humaine, à {adresse.ville}.</h2>
        <p>
          La personne qui répond à votre demande est celle qui prépare le fichier, règle
          la machine et contrôle les pièces. Rien ne se perd entre un commercial et un
          atelier.
        </p>
        <p>
          C’est aussi ce qui permet de dire franchement quand un support ne convient pas,
          plutôt que de livrer un résultat approximatif.
        </p>
        <dl class="studio__reperes">
          <div>
            <dt>Expérience</dt>
            <dd>{site.anneesExperience} ans de pratique</dd>
          </div>
          <div>
            <dt>Équipement</dt>
            <dd>Laser CO₂, UV et fibre, impression UV</dd>
          </div>
          <div>
            <dt>Implantation</dt>
            <dd>{adresse.rue}, {adresse.codePostal} {adresse.ville}</dd>
          </div>
          <div>
            <dt>Zone</dt>
            <dd>{zones.slice(0, 4).join(', ')} et expéditions</dd>
          </div>
        </dl>
        <div class="boutons">
          <a class="bouton bouton--fantome" href="/a-propos/">Découvrir le studio</a>
          <a
            class="bouton bouton--fantome"
            href={reseaux.googleMaps}
            rel="noopener noreferrer"
            target="_blank"
          >
            Nous situer
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== Journal ============================ -->
  <section class="section section--serree section--creuse">
    <div class="enveloppe">
      <div class="tete-section tete-section--duo">
        <div>
          <p class="surtitre">Journal</p>
          <h2>Ce qu’il faut savoir avant de faire fabriquer.</h2>
        </div>
        <p class="chapo">
          Des repères concrets sur les fichiers, les matières, les rendus et les limites
          du procédé — écrits depuis l’établi.
        </p>
      </div>
      <ul class="journal">
        {
          articles.map((article) => (
            <li class="revele">
              <a href={`/blog/${article.id}/`}>
                <span class="journal__meta">{article.data.tempsLecture} de lecture</span>
                <h3>{article.data.titre}</h3>
                <p>{article.data.chapo}</p>
                <span class="lien-fleche">Lire</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SectionDevis
    surtitre="Votre projet"
    titre="Décrivez votre idée, nous vous dirons ce qu’il est possible d’en faire."
    texte="Support, quantité, visuel, délai — ou simplement une intuition et une photo. Nous répondons sur la faisabilité réelle, pas avec un catalogue."
  />
</Base>

<style>
  /*
    Bandeau de chaîne : la signature méthodologique de la marque, et un
    argument commercial à part entière. Il est donc énoncé avant d'être
    décliné, et porté par un filet plein plutôt que par un trait discret.
  */
  .chaine-bandeau {
    margin-block-start: var(--e-2xl);
    padding-block: var(--e-l) var(--e-l);
    border-block-start: 2px solid var(--c-encre);
    border-block-end: 1px solid var(--c-filet);
  }

  .chaine-bandeau__annonce {
    margin-block-end: var(--e-m);
    max-width: 34ch;
    color: var(--c-encre-douce);
    font-size: var(--t-2);
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .chaine-bandeau__annonce strong {
    color: var(--c-encre);
    font-weight: 600;
  }

  /*
    En dessous de 52rem, la séquence tenait sur deux ou trois lignes et les
    filets de liaison se retrouvaient orphelins en fin de ligne, reliant les
    étapes à rien. Sur petit écran, la chaîne devient donc une liste numérotée
    en colonnes, sans filet : la séquence reste lisible, l'accident disparaît.
  */
  .chaine-bandeau__liste {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-2xs) var(--e-m);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: maillon;
  }

  .chaine-bandeau__liste li {
    display: flex;
    align-items: center;
    gap: var(--e-xs);
    color: var(--c-encre);
    font-family: var(--f-mono);
    font-size: var(--t-0);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .chaine-bandeau__liste li::before {
    counter-increment: maillon;
    content: '0' counter(maillon);
    color: var(--c-encre-muette);
  }

  @media (min-width: 52rem) {
    .chaine-bandeau__liste {
      display: flex;
      flex-wrap: nowrap;
      gap: 0;
    }

    .chaine-bandeau__liste li {
      flex: 1 1 auto;
    }

    .chaine-bandeau__liste li:not(:last-child)::after {
      content: '';
      flex: 1;
      block-size: 1px;
      min-inline-size: var(--e-s);
      background-color: var(--c-filet-fort);
    }
  }

  /* ============================== Manifeste =========================== */

  /*
    Une seule phrase, très grande, sur fond sombre, sans image. C'est la
    respiration de la première moitié de page : après le héros et le bandeau
    de méthode, le regard s'arrête. La phrase existait déjà, en petit corps.
  */
  .manifeste__phrase {
    max-width: 22ch;
    color: var(--c-clair-doux);
    font-size: var(--t-5);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .manifeste__phrase strong {
    display: block;
    color: var(--c-clair);
    font-weight: 600;
  }

  .manifeste__suite {
    margin-block-start: var(--e-l);
    max-width: 48ch;
    color: var(--c-clair-muet);
    font-size: var(--t-0);
    line-height: 1.6;
  }

  @media (min-width: 64rem) {
    .manifeste__suite {
      margin-inline-start: auto;
      max-width: 34ch;
      text-align: end;
    }
  }

  /* ====================== Bandeau de fabrication ====================== */

  /*
    `sur-nuit` sur la figure : sans lui, la légende héritait des jetons clairs
    et le marqueur « Atelier », composé en encre, devenait invisible sur le
    fond sombre.
  */
  .bandeau-atelier {
    position: relative;
    margin: 0;
  }

  .bandeau-atelier :global(img) {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center 42%;
  }

  @media (min-width: 52rem) {
    .bandeau-atelier :global(img) {
      aspect-ratio: 21 / 9;
    }
  }

  .bandeau-atelier__legende {
    padding: var(--e-s) var(--gouttiere) var(--e-m);
    max-width: 64ch;
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    line-height: 1.6;
  }

  .bandeau-atelier__marqueur {
    display: block;
    margin-block-end: var(--e-3xs);
    color: var(--c-encre);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ========================= Ce que nous faisons ===================== */

  .trois__grille {
    display: grid;
    gap: var(--e-l);
  }

  @media (min-width: 52rem) {
    .trois__grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--e-xl);
    }
  }

  .trois__bloc {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--e-2xs);
    padding-block-start: var(--e-s);
    border-block-start: 2px solid var(--c-encre);
  }

  .trois__numero {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
  }

  .trois__bloc h3 {
    font-size: var(--t-2);
  }

  .trois__bloc p:not(.trois__numero) {
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    line-height: 1.65;
  }

  .trois__bloc .lien-fleche {
    margin-block-start: auto;
    padding-block-start: var(--e-s);
  }

  /* ============================= Matières ============================ */

  .matieres__grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-m) var(--e-s);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .matieres__grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /*
    Trois colonnes au maximum, jamais six. Sur une seule rangée, les vignettes
    tombaient à 202 × 269 px à 1440 px — plus petites qu'à 1024 px — et la
    section devenait un index au lieu d'une galerie. Ici la qualité de l'image
    prime sur le nombre de colonnes.
  */
  @media (min-width: 68rem) {
    .matieres__grille {
      gap: var(--e-l) var(--e-m);
    }

    /*
      Format un peu plus large sur grand écran : à 450 px de côté, un cadre
      3/4 donnerait des vignettes de 600 px de haut et deux rangées presque
      aussi hautes que l'écran.
    */
    .matieres__media {
      aspect-ratio: 4 / 5;
    }
  }

  .matieres__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-block-end: var(--e-xs);
    background-color: var(--c-blanc);
  }

  /*
    Aucun filtre : la couleur naturelle de la matière EST la démonstration.
    Une version antérieure désaturait ces vignettes ; le noir et blanc rendait
    le métal, le bois et le liège indiscernables, et annulait donc le message
    de la section.
  */
  .matieres__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--duree-longue) var(--courbe-sortie);
  }

  @media (hover: hover) {
    .matieres__item:hover .matieres__media :global(img),
    .matieres__item:focus-within .matieres__media :global(img) {
      transform: scale(1.03);
    }
  }

  .matieres__nom {
    font-size: var(--t-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .matieres__detail {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    line-height: 1.5;
  }

  /* ====================== Appel à l'action intermédiaire ============== */

  /*
    Le bloc répartissait trois éléments sur toute la largeur : le centre restait
    très vide et l'ensemble se lisait comme une barre d'information. La phrase
    et son texte forment désormais un seul groupe à gauche, le bouton reste à
    droite. La hauteur est inchangée.
  */
  .relance__grille {
    display: grid;
    gap: var(--e-xs);
    justify-items: start;
  }

  @media (min-width: 52rem) {
    .relance__grille {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--e-2xl);
      row-gap: var(--e-3xs);
    }

    .relance__titre {
      grid-column: 1;
    }

    .relance__texte {
      grid-column: 1;
    }

    .relance__grille .bouton {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .relance__titre {
    color: var(--c-clair);
    font-size: var(--t-2);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .relance__texte {
    max-width: 52ch;
    color: var(--c-clair-doux);
  }

  /* =========================== Savoir-faire ========================== */

  /*
    L'en-tête est une vraie composition à deux colonnes : le titre et la phrase
    de clientèle à gauche, l'image et sa légende à droite. Auparavant la colonne
    de gauche ne portait que le titre, calé en bas : il restait environ 250 px
    de vide en haut à gauche, qui se lisaient comme un défaut de grille.
  */
  .savoir__entete {
    display: grid;
    gap: var(--e-l);
    margin-block-end: var(--e-2xl);
  }

  @media (min-width: 56rem) {
    .savoir__entete {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      align-items: start;
      gap: var(--e-2xl);
    }
  }

  .savoir__intro h2 {
    margin-block: var(--e-2xs) var(--e-m);
  }

  .savoir__visuel {
    margin: 0;
  }

  /*
    Le `<picture>` reprend une hauteur automatique : la règle globale qui lui
    donne 100 % sert aux cadres à ratio imposé, mais ici elle le faisait
    déborder de la figure et la légende venait manger la marge qui la sépare
    de l'étiquette « Conception ».
  */
  .savoir__visuel :global(picture) {
    block-size: auto;
  }

  .savoir__visuel :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .savoir__visuel figcaption {
    margin-block-start: var(--e-s);
    max-width: 46ch;
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    line-height: 1.55;
  }

  .savoir__famille + .savoir__famille {
    margin-block-start: var(--e-xl);
  }

  .savoir__etiquette {
    margin-block-end: var(--e-xs);
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .savoir__liste {
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--c-filet);
  }

  .savoir__liste li {
    border-block-end: 1px solid var(--c-filet);
  }

  .savoir__liste a {
    display: grid;
    gap: var(--e-3xs);
    padding-block: var(--e-m);
    text-decoration: none;
  }

  @media (min-width: 52rem) {
    .savoir__liste a {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr) auto;
      gap: var(--e-m);
      align-items: baseline;
    }
  }

  .savoir__titre {
    font-size: var(--t-2);
    font-weight: 600;
    letter-spacing: var(--ls-titre);
    transition: transform var(--duree) var(--courbe);
  }

  .savoir__liste a:hover .savoir__titre {
    transform: translateX(0.5rem);
  }

  .savoir__texte {
    color: var(--c-encre-muette);
    font-size: var(--t--1);
    line-height: 1.55;
  }

  .savoir__clients {
    max-width: 46ch;
    color: var(--c-encre-douce);
    font-size: var(--t-0);
    line-height: 1.6;
  }

  .savoir__clients strong {
    color: var(--c-encre);
    font-weight: 600;
  }

  /* =========================== Réalisations ========================== */

  /*
    Troisième volume typographique de la page. Neuf titres de section
    partageaient exactement le même corps : la page parlait sur une seule
    note. Les deux sections pivots — les matières et les réalisations —
    passent au cran au-dessus.
  */
  .titre-fort {
    font-size: var(--t-5);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .realisations__entete {
    margin-block-end: var(--e-xl);
  }

  .realisations__entete h2 {
    margin-block-end: var(--e-l);
  }

  .realisations__pied {
    display: grid;
    gap: var(--e-s);
    padding-block-start: var(--e-s);
    border-block-start: 1px solid var(--c-filet-fort);
  }

  @media (min-width: 52rem) {
    .realisations__pied {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--e-xl);
    }
  }

  .realisations__note {
    max-width: 58ch;
    color: var(--c-encre-douce);
  }

  /*
    Le compteur est décoratif — le même chiffre est lu dans le bouton — mais il
    reste du texte visible : sa teinte doit passer le contraste. Une première
    version en `--c-filet-fort` tombait à 1,79:1.
  */
  .realisations__compte {
    color: color-mix(in srgb, var(--c-encre) 52%, transparent);
    font-family: var(--f-mono);
    font-size: var(--t-4);
    line-height: 1;
  }

  @media (min-width: 52rem) {
    .realisations__compte {
      font-size: var(--t-5);
    }
  }

  .suite {
    margin-block-start: var(--e-xl);
    text-align: center;
  }

  /* ========================= Du dessin à l'objet ===================== */

  .chaine__liste {
    display: grid;
    gap: var(--e-l);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 44rem) {
    .chaine__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 76rem) {
    .chaine__liste {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--e-m);
    }
  }

  .chaine__etape {
    display: grid;
    gap: var(--e-2xs);
    align-content: start;
    padding-block-start: var(--e-s);
    border-block-start: 1px solid var(--c-filet-fort);
  }

  .chaine__numero {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
  }

  .chaine__etape h3 {
    font-size: var(--t-1);
  }

  .chaine__etape p {
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    line-height: 1.65;
  }

  /* ============================== Projets ============================ */

  .projets__liste {
    display: grid;
    gap: var(--e-l);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 52rem) {
    .projets__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-xl);
    }
  }

  .projets__item {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--e-2xs);
    padding: var(--e-m);
    border: 1px solid var(--c-filet);
    background-color: var(--c-blanc);
    transition: border-color var(--duree) var(--courbe);
  }

  /*
    Cadre 3/2 imposé, comme partout ailleurs : le format du fichier ne décide
    pas de la hauteur de la carte.
  */
  .projets__visuel {
    inline-size: 100%;
    margin: 0 0 var(--e-s);
    overflow: hidden;
    background-color: var(--c-fond-creux);
  }

  /* Le ratio est porté par l'image : voir la note de projets.astro. */
  .projets__visuel :global(picture) {
    display: contents;
  }

  .projets__visuel :global(img) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform var(--duree-longue) var(--courbe-sortie);
  }

  /* Rapprochement très léger au survol, comme sur les autres vignettes. */
  @media (hover: hover) {
    .projets__item:hover .projets__visuel :global(img),
    .projets__item:focus-within .projets__visuel :global(img) {
      transform: scale(1.03);
    }
  }

  .projets__legende {
    margin-block-start: var(--e-2xs);
    max-width: 44ch;
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    line-height: 1.55;
  }

  .projets__item:hover {
    border-color: var(--c-filet-fort);
  }

  @media (min-width: 52rem) {
    .projets__item {
      padding: var(--e-xl);
    }
  }

  .projets__nature {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .projets__item h3 {
    font-size: var(--t-3);
  }

  .projets__accroche {
    max-width: 40ch;
    color: var(--c-encre-douce);
    font-size: var(--t-1);
    line-height: 1.5;
  }

  .projets__reperes {
    inline-size: 100%;
    margin-block: var(--e-s);
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--c-filet);
  }

  .projets__reperes li {
    padding-block: var(--e-2xs);
    border-block-end: 1px solid var(--c-filet);
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
  }

  .projets__item .lien-fleche {
    margin-block-start: auto;
  }

  /* ============================== Studio ============================= */

  .studio__grille {
    display: grid;
    gap: var(--e-l);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .studio__grille {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--e-2xl);
    }
  }

  .studio__media {
    margin: 0;
    overflow: hidden;
    background-color: var(--c-fond-creux);
  }

  .studio__copie {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--e-s);
  }

  .studio__copie h2 {
    max-width: 18ch;
    font-size: var(--t-3);
  }

  .studio__copie p {
    max-width: 52ch;
    color: var(--c-encre-douce);
  }

  .studio__reperes {
    inline-size: 100%;
    margin-block: var(--e-s) var(--e-2xs);
    border-block-start: 1px solid var(--c-filet);
  }

  .studio__reperes > div {
    display: grid;
    gap: var(--e-3xs);
    padding-block: var(--e-xs);
    border-block-end: 1px solid var(--c-filet);
  }

  @media (min-width: 34rem) {
    .studio__reperes > div {
      grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
      gap: var(--e-m);
      align-items: baseline;
    }
  }

  .studio__reperes dt {
    color: var(--c-encre-muette);
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .studio__reperes dd {
    margin: 0;
    color: var(--c-encre);
    font-size: var(--t--1);
  }

  /* ============================== Journal ============================ */

  .journal {
    display: grid;
    gap: var(--e-m);
    list-style: none;
