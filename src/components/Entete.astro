---
import { navigation, ctaPrincipal, telephone } from '@data/site';
import Monogramme from './Monogramme.astro';

const chemin = Astro.url.pathname;

function estActif(href: string): boolean {
  if (href === '/') return chemin === '/';
  return chemin === href || chemin.startsWith(href);
}
---

<header class="entete">
  <div class="entete__barre enveloppe--large">
    {/*
      Pas d'aria-label ici : il remplacerait le texte visible par un libellé
      qui ne le contient pas, ce qui échoue au critère WCAG 2.5.3 « Label in
      Name ». Le nom accessible est donc construit à partir du texte visible,
      complété par une précision réservée aux lecteurs d'écran.
    */}
    <a class="entete__marque" href="/">
      {/*
        `taille` ne fixe plus le rendu — le CSS ci-dessous le calcule sur les
        corps du texte — mais elle reste la dimension intrinsèque du SVG, donc
        la place réservée avant l'application des feuilles. La valeur suit la
        hauteur calculée à la largeur de référence : 54 × 30, et non 38 × 21.
      */}
      <Monogramme taille={54} class="entete__logo" />
      <span class="entete__nom">
        <strong>Beaune Gravure</strong>
        <small>Création · Personnalisation · Fabrication</small>
      </span>
      <span class="visuellement-cache"> — retour à l’accueil</span>
    </a>

    <nav class="entete__nav" aria-label="Navigation principale">
      <ul class="entete__liste">
        {
          navigation.map((lien) => (
            <li class={lien.enfants ? 'entete__item entete__item--sous' : 'entete__item'}>
              <a
                href={lien.href}
                class="entete__lien"
                aria-current={estActif(lien.href) ? 'page' : undefined}
              >
                {lien.label}
                {lien.enfants && (
                  <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true" focusable="false">
                    <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                )}
              </a>
              {lien.enfants && (
                <div class="sous-menu">
                  <ul>
                    {lien.enfants.map((enfant) => (
                      <li>
                        <a
                          href={enfant.href}
                          aria-current={chemin === enfant.href ? 'page' : undefined}
                        >
                          {enfant.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="entete__actions">
      <a
        class="entete__tel"
        href={`tel:${telephone.e164}`}
        aria-label={`Appeler l’atelier au ${telephone.affichage}`}
      >
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" focusable="false">
          <path
            d="M4.2 2.6h3l1.5 3.7-1.9 1.2a10.6 10.6 0 0 0 4.7 4.7l1.2-1.9 3.7 1.5v3a1.4 1.4 0 0 1-1.5 1.4A13.9 13.9 0 0 1 2.8 4.1 1.4 1.4 0 0 1 4.2 2.6Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
        <span class="entete__tel-texte">{telephone.affichage}</span>
      </a>
      {/*
        Le libellé complet est réservé aux écrans qui peuvent l'accueillir ;
        en dessous, « Devis » suffit et reste sans ambiguïté à côté du menu.
      */}
      <a class="bouton entete__cta" href={ctaPrincipal.href}>
        <span class="entete__cta-court">Devis</span>
        <span class="entete__cta-long">{ctaPrincipal.label}</span>
      </a>
      <button
        class="entete__bascule"
        type="button"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-bascule-menu
      >
        <span class="visuellement-cache">Ouvrir le menu</span>
        <span class="entete__burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu-mobile" id="menu-mobile" hidden data-menu-mobile>
  <nav class="menu-mobile__contenu enveloppe" aria-label="Navigation mobile">
    {/*
      Le numéro de téléphone ouvre le menu : il est donc placé en tête, avant
      les onze liens de savoir-faire. Il se trouvait auparavant en dernière
      position, ce qui en faisait le contact le moins accessible du site alors
      que c'est le plus direct.
    */}
    <a class="menu-mobile__tel" href={`tel:${telephone.e164}`}>
      Appeler l’atelier · {telephone.affichage}
    </a>

    <ul class="menu-mobile__liste">
      <li>
        <a href="/" aria-current={chemin === '/' ? 'page' : undefined}>Accueil</a>
      </li>
      {
        navigation.map((lien) => (
          <li>
            <a href={lien.href} aria-current={estActif(lien.href) ? 'page' : undefined}>
              {lien.label}
            </a>
            {lien.enfants && (
              <ul class="menu-mobile__sous">
                {lien.enfants.map((enfant) => (
                  <li>
                    <a href={enfant.href}>{enfant.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="menu-mobile__pied">
      <a class="bouton bouton--inverse" href={ctaPrincipal.href}>{ctaPrincipal.label}</a>
    </div>
  </nav>
</div>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: var(--z-entete);
    background-color: color-mix(in srgb, var(--c-fond) 88%, transparent);
    border-block-end: 1px solid var(--c-filet);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .entete__barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-s);
    min-block-size: var(--entete-hauteur);
  }

  /* ---------- Marque ---------- */

  .entete__marque {
    display: flex;
    align-items: center;
    gap: var(--e-2xs);
    flex: none;
    text-decoration: none;
  }

  /*
    LE MONOGRAMME SE MESURE SUR L'ENCRE DU TEXTE, PAS SUR SA BOÎTE.

    Le fichier n'était pas en cause : sa boîte encrée occupe 325,94 × 180,65
    d'un viewBox de 326,4 × 181, soit moins de 0,15 % de marge interne. Le
    centrage non plus : les deux centres tombaient à 40,00 px.

    Le défaut était une affaire de taille. Le symbole mesurait 21 px pour un
    bloc texte dont l'encre — du haut de capitale de « Beaune Gravure » au bas
    de jambage de la baseline — en mesure 30,16 : il ne couvrait que 70 % du
    texte et se lisait comme une pièce rapportée.

    La hauteur est donc calculée sur les deux corps de la ligne. Boîte du bloc
    = 1,15 × (F1 + F2) ; le blanc typographique retire 0,18 × F1 en haut et
    0,18 × F2 en bas, mesuré sur Archivo. Reste 0,97 × (F1 + F2) — 30,23 px
    calculés contre 30,16 mesurés. Aucun nombre magique : la valeur suit les
    jetons, donc le clamp de --t-1, à toutes les largeurs.

    Le décalage vertical corrige le reste : le centre de l'encre est plus bas
    que celui de la boîte, d'un demi-écart entre les deux blancs, soit
    0,09 × (F1 − F2). Sous 26rem la baseline disparaît, le bloc retombe sur une
    ligne, et les deux valeurs se recalculent pour ce seul corps.
  */
  /*
    `:global` EST INDISPENSABLE ICI, et son absence était la cause du défaut.

    Astro ne transmet pas sa portée à la racine d'un composant enfant : le
    `<svg>` du monogramme ne porte pas le `data-astro-cid` de cette page. La
    règle compilée valait `.entete__logo[data-astro-cid-…]` et ne rencontrait
    donc jamais son élément. Elle n'avait aucun effet depuis toujours — la
    taille venait du seul attribut `taille`, figée à 38 × 21, pendant que le
    texte suivait le clamp de --t-1 et grandissait sans elle.
  */
  /*
    Taille compacte par défaut : une hauteur de ligne pleine, soit les 21 px
    que le monogramme a toujours eus sur téléphone et que rien ne reprochait.
    Sous 26rem la baseline est masquée et le bloc tient sur une ligne ; le
    calquer alors sur l'encre donnerait 13 px et ferait de la seule marque
    restante un détail. Elle dépasse donc l'encre, comme il est d'usage pour un
    bloc compact, et reste centrée sur elle.
  */
  .entete__marque :global(.entete__logo) {
    --logo-f1: var(--t-1);
    --logo-f2: 0.6875rem;

    flex: none;
    inline-size: auto;
    block-size: calc(1.2 * var(--logo-f1));
    translate: 0 calc(-0.039 * var(--logo-f1));
  }

  /*
    Dès qu'il y a la place, la marque se cale sur l'encre des deux lignes.

    Le seuil est à 30rem et non à 26rem, là où la baseline réapparaît : entre
    les deux, le symbole calé sur l'encre mesure 50 px de large contre 38, et
    ces douze pixels suffisaient à pousser le bouton de menu hors du cadre —
    cinq pixels de barre horizontale à 430 px, mesurés en comparant les deux
    tailles sur la même page. Le lockup complet attend donc d'avoir de quoi
    tenir.
  */
  @media (min-width: 30rem) {
    .entete__marque :global(.entete__logo) {
      block-size: calc(0.97 * (var(--logo-f1) + var(--logo-f2)));
      translate: 0 calc(0.09 * (var(--logo-f1) - var(--logo-f2)));
    }
  }

  .entete__nom {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .entete__nom strong {
    font-family: var(--f-titre);
    font-size: var(--t-1);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .entete__nom small {
    color: var(--c-encre-muette);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }

  /*
    LE SEUIL EST MESURÉ, PAS CHOISI.

    La baseline réapparaissait à 26rem — 416 px — alors qu'elle ne tient qu'à
    partir de 422. Entre les deux, la barre demandait 417,8 px de contenu pour
    376,1 px disponibles : la marque mesure 264 px, les actions 121,8, et les
    deux gouttières 32. Ni l'une ni l'autre ne peut céder, toutes deux étant en
    `flex: 0 0 auto` avec un minimum automatique — d'où cinq pixels de barre
    horizontale à 417 px, décroissant jusqu'à un seul à 421.

    Le mécanisme était le bon ; seul son déclenchement était trop bas. 27rem
    laisse dix pixels au-dessus du minimum mesuré, de quoi absorber la part
    variable des corps et des gouttières sans jamais rouvrir la brèche.
  */
  @media (max-width: 27rem) {
    .entete__nom small {
      display: none;
    }
  }

  /* ---------- Navigation ---------- */

  .entete__nav {
    display: none;
  }

  .entete__liste {
    display: flex;
    align-items: center;
    gap: var(--e-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entete__item {
    position: relative;
  }

  .entete__lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-m);
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duree-courte) var(--courbe);
  }

  .entete__lien:hover,
  .entete__lien[aria-current='page'] {
    color: var(--c-encre);
  }

  .entete__lien[aria-current='page'] {
    font-weight: 600;
  }

  .entete__lien svg {
    transition: transform var(--duree) var(--courbe);
  }

  /* ---------- Sous-menu ---------- */

  .sous-menu {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(100% + 0.35rem);
    min-inline-size: 17rem;
    padding: var(--e-2xs);
    border: 1px solid var(--c-filet);
    border-radius: var(--r-l);
    background-color: var(--c-blanc);
    box-shadow: var(--ombre-l);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.35rem);
    transition: opacity var(--duree) var(--courbe), transform var(--duree) var(--courbe),
      visibility var(--duree);
  }

  .entete__item--sous:hover .sous-menu,
  .entete__item--sous:focus-within .sous-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .entete__item--sous:hover .entete__lien svg,
  .entete__item--sous:focus-within .entete__lien svg {
    transform: rotate(180deg);
  }

  .sous-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sous-menu a {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--r-m);
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    text-decoration: none;
    transition: background-color var(--duree-courte) var(--courbe),
      color var(--duree-courte) var(--courbe);
  }

  .sous-menu a:hover,
  .sous-menu a[aria-current='page'] {
    background-color: var(--c-fond-creux);
    color: var(--c-encre);
  }

  /* ---------- Actions ---------- */

  .entete__actions {
    display: flex;
    align-items: center;
    gap: var(--e-2xs);
    flex: none;
  }

  /*
    Sur mobile, la barre ne porte que deux commandes : le devis et le menu.
    L'icône téléphone occupait auparavant cette place et le devis était relégué
    en avant-dernière position du menu — l'appel à l'action principal n'était
    donc jamais visible sans ouvrir le menu. Le téléphone reste à un geste : il
    ouvre désormais le menu mobile.
  */
  .entete__tel {
    display: none;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--c-filet-fort);
    border-radius: var(--r-m);
    color: var(--c-encre);
    text-decoration: none;
  }

  .entete__tel-texte {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .entete__tel:hover {
    color: var(--c-encre);
  }

  /*
    Le devis est visible dès le plus petit écran. Le libellé se raccourcit sous
    26rem pour tenir à côté de la marque sans que la barre ne devienne une
    rangée de boutons.
  */
  .entete__cta {
    display: inline-flex;
    min-block-size: 2.75rem;
    padding-inline: var(--e-s);
    white-space: nowrap;
  }

  .entete__cta-long {
    display: none;
  }

  /*
    Le libellé long n'apparaît qu'une fois qu'il tient réellement. À 26rem il
    s'affichait dès 416 px : additionné à la marque et au bouton de menu, la
    barre dépassait la fenêtre — un iPhone 430 défilait horizontalement. Le
    seuil est reporté à 36rem, où les trois éléments tiennent avec leurs
    gouttières.
  */
  @media (min-width: 36rem) {
    .entete__cta-court {
      display: none;
    }

    .entete__cta-long {
      display: inline;
    }
  }

  /* ---------- Bascule mobile ---------- */

  .entete__bascule {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--c-filet-fort);
    border-radius: var(--r-m);
    color: var(--c-encre);
  }

  .entete__burger,
  .entete__burger::before,
  .entete__burger::after {
    display: block;
    inline-size: 1.05rem;
    block-size: 1.5px;
    background-color: currentColor;
    transition: transform var(--duree) var(--courbe), opacity var(--duree-courte) var(--courbe);
  }

  .entete__burger {
    position: relative;
  }

  .entete__burger::before,
  .entete__burger::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .entete__burger::before {
    inset-block-start: -0.32rem;
  }

  .entete__burger::after {
    inset-block-start: 0.32rem;
  }

  [aria-expanded='true'] .entete__burger {
    background-color: transparent;
  }

  [aria-expanded='true'] .entete__burger::before {
    transform: translateY(0.32rem) rotate(45deg);
  }

  [aria-expanded='true'] .entete__burger::after {
    transform: translateY(-0.32rem) rotate(-45deg);
  }

  /* ---------- Menu mobile ---------- */

  .menu-mobile {
    position: fixed;
    inset: var(--entete-hauteur) 0 0;
    z-index: var(--z-menu);
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--c-fond);
    animation: menu-entree var(--duree) var(--courbe-sortie);
  }

  @keyframes menu-entree {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .menu-mobile__contenu {
    display: flex;
    flex-direction: column;
    gap: var(--e-l);
    padding-block: var(--e-m) var(--e-xl);
  }

  .menu-mobile__liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-mobile__liste > li {
    border-block-end: 1px solid var(--c-filet);
  }

  .menu-mobile__liste > li > a {
    display: block;
    padding-block: var(--e-s);
    font-family: var(--f-titre);
    font-size: var(--t-2);
    text-decoration: none;
  }

  .menu-mobile__liste > li > a[aria-current='page'] {
    color: var(--c-encre-muette);
  }

  .menu-mobile__sous {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--e-s);
    display: grid;
    gap: 1px;
  }

  .menu-mobile__sous a {
    display: block;
    padding: 0.7rem 0;
    color: var(--c-encre-douce);
    font-size: var(--t--1);
    text-decoration: none;
  }

  .menu-mobile__sous a:hover {
    color: var(--c-encre);
  }

  .menu-mobile__pied {
    display: grid;
    gap: var(--e-s);
    justify-items: start;
  }

  .menu-mobile__pied .bouton {
    inline-size: 100%;
  }

  /* Placé en tête du menu : il doit se lire comme une action, pas comme un lien. */
  .menu-mobile__tel {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-block-end: var(--e-m);
    padding-block-end: var(--e-s);
    border-block-end: 1px solid var(--c-filet);
    color: var(--c-encre);
    font-size: var(--t-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* ---------- Points de rupture ---------- */


  /*
    Seuil de bascule vers la navigation de bureau. Mesuré : la barre complète
    (marque, navigation, téléphone, bouton de devis) demande 1092 px. À 64rem
    (1024 px) elle débordait donc de 68 px et provoquait un défilement
    horizontal sur les écrans de tablette en paysage. Le seuil est porté à
    70rem (1120 px), qui laisse une marge réelle.
    Toute modification ici doit être reportée sur le `matchMedia` du script.
  */
  @media (min-width: 70rem) {
    .entete__nav {
      display: block;
    }

    .entete__tel {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      inline-size: auto;
      block-size: auto;
      padding: 0.5rem 0.25rem;
      border: 0;
      margin-inline-end: var(--e-2xs);
      color: var(--c-encre-douce);
      font-size: var(--t--1);
      font-weight: 500;
      white-space: nowrap;
    }

    .entete__tel-texte {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
    }

    .entete__bascule {
      display: none;
    }

    .menu-mobile {
      display: none;
    }
  }
</style>

<script>
  const bascule = document.querySelector<HTMLButtonElement>('[data-bascule-menu]');
  const menu = document.querySelector<HTMLElement>('[data-menu-mobile]');

  if (bascule && menu) {
    const libelle = bascule.querySelector('.visuellement-cache');

    const definirEtat = (ouvert: boolean) => {
      bascule.setAttribute('aria-expanded', String(ouvert));
      menu.hidden = !ouvert;
      document.documentElement.style.overflow = ouvert ? 'hidden' : '';
      if (libelle) libelle.textContent = ouvert ? 'Fermer le menu' : 'Ouvrir le menu';
    };

    bascule.addEventListener('click', () => {
      definirEtat(bascule.getAttribute('aria-expanded') !== 'true');
    });

    // Échap ferme le menu et rend le focus au bouton.
    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && !menu.hidden) {
        definirEtat(false);
        bascule.focus();
      }
    });

    // Le passage en affichage bureau doit toujours rendre le défilement.
    const bureau = window.matchMedia('(min-width: 70rem)');
    bureau.addEventListener('change', (evenement) => {
      if (evenement.matches) definirEtat(false);
    });
  }
</script>
