---
import CarteRealisation from './CarteRealisation.astro';
import type { Realisation } from '@data/realisations';

interface Props {
  realisations: Realisation[];
  /** Nombre de colonnes visé sur grand écran. */
  colonnes?: 2 | 3 | 4;
  /** Nombre d'images chargées en priorité (celles au-dessus de la ligne de flottaison). */
  prioritaires?: number;
  sansLegende?: boolean;
}

const {
  realisations,
  colonnes = 3,
  prioritaires = 0,
  sansLegende = false,
} = Astro.props;

/* La grille tient deux colonnes dès le mobile : les largeurs en tiennent compte. */
const sizes =
  colonnes === 4
    ? '(min-width: 68rem) 23vw, 46vw'
    : colonnes === 2
      ? '46vw'
      : '(min-width: 68rem) 31vw, 46vw';
---

<div class="grille-realisations" data-colonnes={colonnes}>
  {
    realisations.map((realisation, index) => (
      <CarteRealisation
        realisation={realisation}
        sizes={sizes}
        prioritaire={index < prioritaires}
        sansLegende={sansLegende}
      />
    ))
  }
</div>

<style>
  /*
    Colonnes de type « mur d'images » : chaque photo garde son ratio natif, donc
    aucune image n'est déformée ni recadrée arbitrairement. Le rendu est
    volontairement irrégulier, comme une planche-contact d'atelier.
  */
  /*
    Deux colonnes dès le mobile : une colonne unique donnait une image par
    écran, et il fallait près de quatre écrans pour parcourir six pièces. La
    densité sert ici la découverte, pas l'économie de place.
  */
  .grille-realisations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-s);
  }

  @media (min-width: 40rem) {
    .grille-realisations {
      gap: var(--e-m);
    }
  }

  @media (min-width: 68rem) {
    .grille-realisations[data-colonnes='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grille-realisations[data-colonnes='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Alignement en colonnes indépendantes pour éviter les lignes trop creuses. */
  @supports (grid-template-rows: masonry) {
    .grille-realisations {
      grid-template-rows: masonry;
    }
  }
</style>
