---
import CarteRealisation from './CarteRealisation.astro';
import { SIZES_VIGNETTE } from '@data/realisations';
import type { Realisation } from '@data/realisations';

interface Props {
  realisations: Realisation[];
  /** Nombre de colonnes visé sur grand écran. */
  colonnes?: 2 | 3 | 4;
  /** Nombre d'images chargées en priorité (celles au-dessus de la ligne de flottaison). */
  prioritaires?: number;
  sansLegende?: boolean;
  /**
   * Met la première pièce en scène sur quatre cellules. Réservé à la page
   * d'accueil : sur les pages de catalogue, toutes les pièces se valent.
   */
  vedette?: boolean;
}

const {
  realisations,
  colonnes = 3,
  prioritaires = 0,
  sansLegende = false,
  vedette = false,
} = Astro.props;

/* La grille tient deux colonnes dès le mobile : les largeurs en tiennent compte. */
const sizes =
  colonnes === 4
    ? '(min-width: 68rem) 23vw, 46vw'
    : colonnes === 2
      ? '46vw'
      : SIZES_VIGNETTE;

/* La pièce mise en scène occupe deux colonnes : elle demande une image plus large. */
const sizesVedette = '(min-width: 68rem) 63vw, 94vw';
---

<div class="grille-realisations" data-colonnes={colonnes} data-vedette={vedette || undefined}>
  {
    realisations.map((realisation, index) => (
      <CarteRealisation
        realisation={realisation}
        sizes={vedette && index === 0 ? sizesVedette : sizes}
        largeurs={vedette && index === 0 ? [640, 900, 1200] : undefined}
        prioritaire={index < prioritaires}
        sansLegende={sansLegende}
      />
    ))
  }
</div>

<style>
  /*
    Grille régulière : les vignettes sont carrées (voir CarteRealisation), donc
    les lignes s'alignent et les légendes se lisent sur une même ligne de base.
    L'irrégularité précédente venait des formats de fichiers, pas d'un choix de
    composition.
  */
  /*
    Deux colonnes dès le mobile : une colonne unique donnait une image par
    écran, et il fallait près de quatre écrans pour parcourir six pièces. La
    densité sert ici la découverte, pas l'économie de place.
  */
  .grille-realisations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-s);
  }

  @media (min-width: 40rem) {
    .grille-realisations {
      gap: var(--e-m);
    }
  }

  /*
    Pièce mise en scène. Sur mobile elle traverse les deux colonnes ; à partir
    de trois colonnes elle occupe un carré de deux cellules sur deux, et les
    cinq autres pièces remplissent exactement les cellules restantes — la
    grille reste pleine, sans trou.
  */
  /* `:global` est nécessaire : la vignette est le composant enfant, qui porte
     sa propre portée de style. */
  .grille-realisations[data-vedette] > :global(:first-child) {
    grid-column: span 2;
  }

  @media (min-width: 68rem) {
    .grille-realisations[data-vedette][data-colonnes='3'] > :global(:first-child) {
      grid-row: span 2;
    }
  }

  /*
    Depuis que chaque carte occupe deux rangées — une pour l'image, une pour le
    texte —, la pièce mise en scène doit couvrir la hauteur de DEUX cartes,
    soit quatre rangées. Elle sort de la sous-grille et redevient une colonne
    flex : elle n'a que deux enfants, qui ne sauraient remplir quatre rangées,
    et elle est seule sur sa colonne — il n'y a personne avec qui aligner sa
    légende.
  */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 68rem) {
      .grille-realisations[data-vedette][data-colonnes='3'] > :global(:first-child) {
        display: flex;
        grid-row: span 4;
        grid-template-rows: none;
      }
    }
  }

  /*
    Tant que la grille n'a que deux colonnes, la pièce mise en scène occupe
    toute la largeur : un carré y deviendrait un bloc d'un écran et quart à
    1024 px. Elle prend donc un format paysage, et ne redevient carrée qu'à
    partir de trois colonnes, où elle occupe deux cellules sur deux.
    Sélecteur global : la vignette est le composant enfant.
  */
  :global(.grille-realisations[data-vedette] > .realisation:first-child .realisation__cadre) {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 68rem) {
    :global(
      .grille-realisations[data-vedette][data-colonnes='3']
        > .realisation:first-child
        .realisation__cadre
    ) {
      aspect-ratio: 1 / 1;
    }
  }

  @media (min-width: 68rem) {
    .grille-realisations[data-colonnes='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grille-realisations[data-colonnes='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

</style>
