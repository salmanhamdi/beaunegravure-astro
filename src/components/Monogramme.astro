---
/**
 * Monogramme Beaune Gravure.
 *
 * Le « B » hérite de la couleur du texte via `currentColor`, afin de rester
 * lisible aussi bien sur le papier clair que sur les fonds sombres. Le « G »
 * conserve le rouge de la marque, seule touche de rouge du site : le ton
 * d'origine (#e00000) a été assourdi en #b81524 pour s'accorder à la palette.
 */
interface Props {
  taille?: number;
  class?: string;
}

const { taille = 34, class: classe } = Astro.props;
const hauteur = Math.round((taille * 181) / 326.4);
---

<svg
  class={classe}
  viewBox="0 0 326.4 181"
  width={taille}
  height={hauteur}
  role="img"
  aria-label="Beaune Gravure"
  focusable="false"
>
    <path fill="currentColor" d="M30.22,180.72v-30.21h69.25c21.52-1.61,28.84-28.71,10.99-41.2-2.02-1.41-7.16-3.64-9.56-3.64H.22v-30.21h100.92c4.07,0,10.88-4.3,13.55-7.32,12.69-14.32,3.52-36.69-15.48-37.76l-69.07-.05L.22.17h100.21c33.07,1.95,56.09,32.15,48.95,64.74-2.14,9.76-7.34,18.67-14.52,25.53,6.85,6.52,12.08,15.07,14.28,24.33,7.76,32.73-14.61,63.51-47.99,65.95H30.22Z" />
    <path fill="var(--logo-accent, #b81524)" d="M314.11,27.23l-22.69,20.61c-3.12-2.33-6.02-5-9.32-7.16-20.55-13.49-49.54-13.74-70.42-.81-36.67,22.69-39.31,72.61-4.42,98.37,25.76,19.02,65.56,15.78,87.1-8.12l31.78,9.85c.2.23-1.31,2.25-1.58,2.61-27.77,38.19-85.14,49.23-126.02,26.2-24.22-13.65-43.22-37.68-47.08-65.66-4.62-33.44,8.58-61.96,34.41-82.56,35.85-28.6,90.34-26.9,124.92,2.99.74.64,2.69,2.21,3.13,2.87.16.24.36.53.19.82Z" />
