---
/**
 * Polices auto-hébergées.
 *
 * Choix typographique
 * -------------------
 * Une seule famille de texte, **Archivo**, en axe de graisse variable. C'est
 * une grotesque d'ingénierie, dessinée pour la signalétique et le texte long :
 * elle porte les grands titres comme les paragraphes sans changer de registre.
 * Le contraste se fait par la graisse et l'échelle, pas par un second dessin.
 *
 * **IBM Plex Mono** intervient uniquement sur les éléments techniques :
 * sur-titres, numéros d'étape, dimensions, références matière. Le monospace a
 * ici une raison d'être — il évoque la fiche technique et le fichier de
 * fabrication, qui sont le quotidien de l'atelier.
 *
 * Aucune serif : la serif italique est le registre de Glassora, marque sœur.
 * La maison mère doit s'en distinguer.
 *
 * Livraison
 * ---------
 * Sous-ensemble latin uniquement, deux fichiers, environ 50 Ko au total.
 * Les deux sont préchargés : ils servent tous les deux au premier rendu.
 */
import texte from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import mono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

/** Plage latine suffisante pour le français, œ et € compris. */
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
---

<link rel="preload" as="font" type="font/woff2" href={texte} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={mono} crossorigin="anonymous" />

<style is:inline set:html={`
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url(${texte}) format('woff2-variations');
  unicode-range: ${LATIN};
}
@font-face {
  font-family: 'Plex Mono';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(${mono}) format('woff2');
  unicode-range: ${LATIN};
}
`} />
