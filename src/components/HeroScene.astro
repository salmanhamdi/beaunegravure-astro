---
import { Picture } from 'astro:assets';

/*
  Scène d'ouverture : une photographie pleine largeur, et le texte posé dans la
  zone que la lumière y laisse libre — jamais une colonne de texte à côté d'une
  image. Le composant est partagé pour que toutes les pages qui l'emploient
  soient rigoureusement identiques : une seule feuille de style, un seul
  comportement responsive, un seul traitement de lisibilité.

  La photographie doit être cadrée en 2/1 et présenter une zone claire à gauche.
  Le voile ne rattrape que la retombée de lumière ; il ne sauve pas une image
  sombre sur toute sa largeur.
*/

/** Jeu d'icônes des preuves. Trait de 1,5, même grille 24 que le reste du site. */
const ICONES = {
  precision: '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="12" r="2.4" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  series:
    '<path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m3.5 12 8.5 4.5 8.5-4.5M3.5 16.5 12 21l8.5-4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  accompagnement:
    '<path d="M20 12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18.4 3.6a1.8 1.8 0 0 1 2.5 2.5L13.5 13.5l-3.3.8.8-3.3 7.4-7.4Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  franchise:
    '<path d="M20.5 12.5a7.5 7.5 0 0 1-10.9 6.7L4 20.5l1.3-5.6A7.5 7.5 0 1 1 20.5 12.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m9.2 12.4 2 2 3.6-3.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  interlocuteur:
    '<circle cx="12" cy="8.2" r="3.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4.8 20.2a7.2 7.2 0 0 1 14.4 0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  validation:
    '<path d="M6 3.5h8.5L19 8v12.5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14.2 3.6V8H18.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m8.6 14.4 2 2 4.2-4.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
} as const;

interface Preuve {
  icone: keyof typeof ICONES;
  titre: string;
  detail: string;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  surtitre: string;
  /** Une entrée par ligne : la coupe du titre est composée, jamais subie. */
  lignesTitre: string[];
  chapo: string;
  actions: { texte: string; href: string; fantome?: boolean }[];
  preuves: Preuve[];
}

const { image, alt, surtitre, lignesTitre, chapo, actions, preuves } = Astro.props;
---

<section class="hero">
  <figure class="hero__media">
    <Picture
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      quality={76}
      formats={['avif']}
      fallbackFormat="webp"
    />
  </figure>

  {/*
    Voile de lisibilité, et non aplat : deux dégradés calés sur la source de
    lumière déjà présente dans l'image — l'ouverture claire en haut à gauche.
    Ils s'éteignent avant d'atteindre le sujet, qui reste photographique.
  */}
  <div class="hero__voile" aria-hidden="true"></div>

  <div class="hero__texte enveloppe--large">
    {Astro.slots.has('fil') && (
      <div class="hero__fil">
        <slot name="fil" />
      </div>
    )}
    <p class="surtitre">{surtitre}</p>
    <h1>
      {
        lignesTitre.map((ligne, index) => (
          <>
            {index > 0 && <br />}
            {ligne}
          </>
        ))
      }
    </h1>
    <p class="hero__chapo">{chapo}</p>
    <div class="boutons hero__boutons">
      {
        actions.map((action) => (
          <a class={action.fantome ? 'bouton bouton--fantome' : 'bouton'} href={action.href}>
            {action.texte}
          </a>
        ))
      }
    </div>
  </div>

  <div class="hero__socle enveloppe--large">
    <ul class="hero__preuves">
      {
        preuves.map((preuve) => (
          <li>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" set:html={ICONES[preuve.icone]} />
            <span>
              <strong>{preuve.titre}</strong>
              {preuve.detail}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
/*
  Mobile : une pile lisible — le texte porte d'abord, la photographie arrive
  ensuite en pleine largeur, les preuves ferment. `order` permet de garder la
  photographie en tête du DOM pour le LCP sans subir cet ordre à l'écran.
*/
.hero {
  display: flex;
  flex-direction: column;
  padding-block-start: var(--e-xl);
  background-color: var(--c-fond);
}

.hero__texte {
  order: 1;
  display: flex;
  flex-direction: column;
  align-items: start;
}

/* Le fil d'Ariane, quand il est fourni, respire au-dessus du surtitre. */
.hero__fil {
  margin-block-end: var(--e-xs);
}

.hero__media {
  order: 2;
  position: relative;
  margin: var(--e-l) 0 0;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background-color: var(--c-fond-creux);
}

.hero__media :global(img) {
  inline-size: 100%;
  block-size: 100%;
  object-fit: cover;
  /* Cadrage mobile : la tête laser et la plaque, pas le mur vide. */
  object-position: 62% 45%;
}

.hero__voile {
  display: none;
}

.hero h1 {
  margin-block-start: var(--e-2xs);
  max-width: 14ch;
  font-size: var(--t-6);
  font-weight: var(--gr-titre);
  line-height: var(--lh-serre);
  letter-spacing: var(--ls-serre);
  text-wrap: balance;
}

.hero__chapo {
  margin-block-start: var(--e-m);
  max-width: 40ch;
  color: var(--c-encre-douce);
  font-size: var(--t-1);
  line-height: 1.55;
}

.hero__boutons {
  margin-block-start: var(--e-l);
}

/* Trois preuves courtes : lues d'un coup d'œil, jamais surchargées. */
.hero__socle {
  order: 3;
}

.hero__preuves {
  display: grid;
  gap: var(--e-m);
  margin-block: var(--e-l) 0;
  padding: 0;
  list-style: none;
}

.hero__preuves li {
  display: flex;
  align-items: start;
  gap: var(--e-xs);
}

/*
  Le fond des preuves n'est pas un aplat mais une photographie éclaircie :
  `--c-encre-muette` n'y tiendrait pas le rapport de 4,5:1. Le texte
  secondaire passe donc d'un cran plus dense.
*/
.hero__preuves svg {
  flex: none;
  margin-block-start: 2px;
  color: var(--c-encre-douce);
}

.hero__preuves span {
  display: flex;
  flex-direction: column;
  gap: 1px;
  color: var(--c-encre-douce);
  font-size: var(--t--2);
  line-height: 1.45;
}

.hero__preuves strong {
  color: var(--c-encre);
  font-size: var(--t--1);
  font-weight: var(--gr-fort);
  letter-spacing: -0.005em;
  text-wrap: balance;
}

@media (min-width: 40rem) {
  .hero__preuves {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e-l);
  }
}

/*
  Desktop : une seule scène. La photographie et le voile occupent les deux
  rangées de la grille ; le texte se centre dans la première, les preuves
  reposent dans la seconde. Aucun élément n'est positionné en absolu : la
  hauteur du héros reste pilotée par son contenu.
*/
@media (min-width: 64rem) {
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    /*
      La hauteur suit la proportion de la photographie (2/1) plutôt qu'une
      fraction de la fenêtre : le cadrage reste celui qui a été composé, et
      la machine n'est jamais rognée. Le plancher garde le héros habitable
      sur les petits portables, le plafond l'empêche d'écraser la suite.
    */
    min-block-size: min(88vh, 48rem);
    padding-block-start: 0;
    background-color: var(--c-fond-creux);
  }

  .hero__media,
  .hero__voile {
    grid-area: 1 / 1 / 3 / 2;
  }

  .hero__media {
    margin: 0;
    z-index: 0;
    aspect-ratio: auto;
    block-size: 100%;
  }

  .hero__media :global(img) {
    /* Plein cadre : le mur clair à gauche devient l'espace du titre. */
    object-position: 50% 50%;
  }

  /*
    `.hero__media` étant positionné, il peindrait au-dessus d'un voile
    statique : les trois calques sont donc explicitement empilés.
  */
  .hero__voile {
    display: block;
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  .hero__texte {
    grid-area: 1 / 1 / 2 / 2;
    position: relative;
    z-index: 2;
    align-self: center;
    padding-block-start: var(--e-xl);
  }

  .hero__socle {
    grid-area: 2 / 1 / 3 / 2;
    position: relative;
    z-index: 2;
    padding-block-end: var(--e-l);
  }

  .hero__preuves {
    margin-block: 0;
    /*
      Les trois preuves restent dans le champ lumineux : au-delà, elles
      tomberaient sur la plaque gravée et deviendraient illisibles. Le bloc
      est calé à gauche, pas centré : « enveloppe--large » gouverne la
      gouttière, ce `max-inline-size` gouverne la colonne.
    */
    max-inline-size: 33rem;
    gap: var(--e-s);
  }

  .hero h1 {
    max-width: 11ch;
  }

  .hero__chapo {
    max-width: 37ch;
  }
}

/*
  Le voile suit la lumière déjà présente dans la photographie : l'ouverture
  claire est en haut à gauche, donc la clarté vient de la gauche. Le second
  dégradé ne relève que l'angle inférieur gauche, où la table du laser est
  sombre — c'est là que se posent les preuves. Les deux s'éteignent avant la
  machine.
*/
.hero__voile {
  background:
    /*
      Reprise de la retombée de lumière : l'angle inférieur gauche est la
      zone la plus sombre de la photographie (luminance mesurée 93 sur 255),
      c'est là que le champ doit être le plus dense.
    */
    radial-gradient(
        86% 90% at -4% 100%,
        color-mix(in srgb, var(--c-fond) 94%, transparent),
        color-mix(in srgb, var(--c-fond) 74%, transparent) 46%,
        transparent 80%
      ),
    linear-gradient(
      to right,
      color-mix(in srgb, var(--c-fond) 94%, transparent) 0%,
      color-mix(in srgb, var(--c-fond) 90%, transparent) 28%,
      color-mix(in srgb, var(--c-fond) 74%, transparent) 44%,
      color-mix(in srgb, var(--c-fond) 36%, transparent) 58%,
      transparent 72%
    );
}

/*
  Entre 1024 et 1280 px, la colonne de texte occupe une part plus large de
  l'écran : le champ lumineux s'étend d'autant, sinon la troisième preuve
  retomberait sur la plaque gravée.
*/
@media (min-width: 64rem) and (max-width: 79.99rem) {
  /*
    Sur les petits portables, un héros aussi haut ferait perdre près d’un
    tiers de la largeur de la photographie au recadrage « cover ». On le
    raccourcit pour rester proche de la proportion d’origine.
  */
  .hero {
    min-block-size: min(76vh, 40rem);
  }

  .hero__voile {
    background:
      radial-gradient(
          88% 86% at -4% 100%,
          color-mix(in srgb, var(--c-fond) 94%, transparent),
          color-mix(in srgb, var(--c-fond) 70%, transparent) 46%,
          transparent 78%
        ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--c-fond) 94%, transparent) 0%,
        color-mix(in srgb, var(--c-fond) 88%, transparent) 30%,
        color-mix(in srgb, var(--c-fond) 62%, transparent) 48%,
        color-mix(in srgb, var(--c-fond) 22%, transparent) 64%,
        transparent 78%
      );
  }
}
</style>
