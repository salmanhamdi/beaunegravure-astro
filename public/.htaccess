# Beaune Gravure — configuration Apache / LiteSpeed pour un site statique.

# --------------------------------------------------------------------------
# En-têtes de sécurité
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # HSTS : à n'activer qu'une fois le HTTPS confirmé sur le domaine définitif.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Le site n'appelle aucun service tiers : la politique peut rester stricte.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    # Les fichiers versionnés par Astro sont immuables.
    <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Le HTML doit être revalidé pour que les mises à jour soient visibles.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Types MIME
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# --------------------------------------------------------------------------
# Fichiers sensibles
# --------------------------------------------------------------------------
<FilesMatch "^(config\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 /\.git
RedirectMatch 404 /api/\.data

# --------------------------------------------------------------------------
# URL canoniques : slash final, sans www
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www -> domaine nu. Activée le 29/10/2026 : « www » est un alias DNS de
    # l'apex et servait donc le site à deux adresses, le même contenu sous
    # deux noms. La balise canonique le disait déjà à Google ; une 301 le dit
    # à tout le monde, et consolide pour de bon les signaux de l'ancien
    # domaine en « www » vers le domaine nu.
    #
    # Placée AVANT la règle HTTPS à dessein : comme elle réécrit déjà vers
    # « https:// », « http://www » atteint le domaine nu en UNE redirection
    # au lieu de deux (http://www -> https://www -> https://nu).
    RewriteCond %{HTTP_HOST} ^www\.beaunegravure\.fr$ [NC]
    RewriteRule ^(.*)$ https://beaunegravure.fr/$1 [R=301,L]

    # HTTPS obligatoire.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Ancienne page du site Wix, supprimée définitivement le 03/11/2026.
    #
    # 410 plutôt que 404 : « supprimée » au lieu de « introuvable ». Les deux
    # retirent l'URL de l'index, mais Google traite le 410 sans repasser
    # plusieurs fois pour vérifier que l'absence dure. C'est cette URL qui
    # alimentait encore le lien de site « APPLICATIONS » sous le résultat de
    # recherche, des semaines après la bascule.
    #
    # Placée avant la règle de slash final pour couvrir les deux écritures
    # d'un coup, sans passer par une 301 intermédiaire.
    RewriteRule ^applications/?$ - [G,L]

    # ----------------------------------------------------------------------
    # Anciennes URL du site Wix, redirigees le 09/11/2026.
    #
    # Search Console a signale 11 URL « Introuvable (404) » : ce sont toutes
    # des pages de l'ancien site Wix, encore explorees par Google des mois
    # apres la bascule (boutique, fiches produit, pages de presentation).
    #
    # Une 301 vers la page vivante la plus proche vaut mieux qu'un 404 : elle
    # transmet le capital de liens accumule par l'ancienne adresse, et elle
    # amene le visiteur venu d'un lien ancien sur un contenu utile au lieu
    # d'une page d'erreur.
    #
    # Chaque motif s'arrete avant le premier caractere accentue de l'ancienne
    # URL (« a glissiere »), afin de ne dependre ni de l'encodage du chemin
    # ni de la facon dont Apache le decode.
    #
    # Placees avant la regle de slash final pour couvrir les deux ecritures
    # d'un coup, sans 301 intermediaire.
    RewriteRule ^product-page/(copie-de-)?caisse-bois-vin https://beaunegravure.fr/services/caisses-bois-gravees/ [R=301,L]
    RewriteRule ^product-page/tire-bouchon https://beaunegravure.fr/realisations/objets/sommellerie-et-couteaux/ [R=301,L]
    RewriteRule ^product-page/bouteilles-isothermes https://beaunegravure.fr/realisations/objets/gourdes-et-contenants/ [R=301,L]
    RewriteRule ^product-page/plaque-signal https://beaunegravure.fr/services/signaletique/ [R=301,L]
    RewriteRule ^product-page/ https://beaunegravure.fr/realisations/ [R=301,L]
    RewriteRule ^boutique/?$ https://beaunegravure.fr/realisations/ [R=301,L]
    RewriteRule ^quisommesnous/?$ https://beaunegravure.fr/a-propos/ [R=301,L]
    RewriteRule ^matieres/?$ https://beaunegravure.fr/services/ [R=301,L]

    # 12/11/2026 : ces deux anciennes pages Wix n'avaient aucune regle. Elles
    # tombaient sur la regle de slash final, puis sur une 404 - Bing les
    # connait encore et les proposait donc vers une erreur.
    #   phototheque        : la galerie de l'ancien site.
    #   envoyezvosfichiers : la page d'envoi de fichiers, dont le formulaire
    #                        de contact a repris le role.
    RewriteRule ^phototheque/?$ https://beaunegravure.fr/realisations/ [R=301,L]
    RewriteRule ^envoyezvosfichiers/?$ https://beaunegravure.fr/contact/ [R=301,L]

    # Ajoute le slash final aux URL de pages, hors fichiers réels.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# Page d'erreur
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# Les pages supprimées définitivement servent la même page que les introuvables.
# Le visiteur n'a que faire de la nuance ; le robot, lui, lit le code HTTP, qui
# reste 410.
ErrorDocument 410 /404.html
